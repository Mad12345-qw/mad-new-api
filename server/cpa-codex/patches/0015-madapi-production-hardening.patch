+func TestMadAPICodexFirstEventTimeoutClampsAtSixtySeconds(t *testing.T) {
+	if got := madAPICodexFirstEventTimeout(60); got != 60*time.Second {
+		t.Fatalf("60 second timeout = %s", got)
+	}
+	if got := madAPICodexFirstEventTimeout(90); got != 60*time.Second {
+		t.Fatalf("90 second timeout was not clamped: %s", got)
+	}
+}
