+}
+
+func ConvertCPAChatResponseToResponsesNonStream(ctx context.Context, modelName string, originalRequest, convertedRequest, response []byte) []byte {
+	return cparesponses.ConvertOpenAIChatCompletionsResponseToOpenAIResponsesNonStream(
+		ctx, modelName, originalRequest, convertedRequest, response, nil,
+	)
+}
+
+func ConvertCPAChatResponseToResponsesStream(ctx context.Context, modelName string, originalRequest, convertedRequest, response []byte, state *any) [][]byte {
