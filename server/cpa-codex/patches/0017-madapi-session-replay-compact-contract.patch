+package openai
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func resetMadAPIResponseSessions() {
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries = make(map[string]madAPIResponseSessionState)
+	madAPIResponseSessions.totalBytes = 0
+	madAPIResponseSessions.Unlock()
+}
+
+func TestMadAPIResponseSessionReplaysReasoningAndToolCall(t *testing.T) {
+	resetMadAPIResponseSessions()
+	first := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"run tool"}]}`)
+	response := []byte(`{"id":"resp-1","output":[{"type":"reasoning","id":"rs-1"},{"type":"function_call","call_id":"call-1","name":"lookup","arguments":"{}"}]}`)
+	rememberMadAPIResponseSession("scope-a", first, response)
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"deepseek-v4","previous_response_id":"resp-1","input":[{"type":"function_call_output","call_id":"call-1","output":"ok"}]}`))
+	if err != nil {
+		t.Fatalf("prepare continuation: %v", err)
+	}
+	for _, want := range []string{`"type":"reasoning"`, `"type":"function_call"`, `"type":"function_call_output"`} {
+		if !strings.Contains(string(continued), want) {
+			t.Fatalf("continuation lost %s: %s", want, continued)
+		}
+	}
+	if strings.Contains(string(continued), "previous_response_id") {
+		t.Fatalf("provider state leaked: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionIsTokenScoped(t *testing.T) {
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[]}`))
+	if _, err := prepareMadAPIResponseSessionRequest("scope-b", []byte(`{"model":"deepseek-v4","previous_response_id":"resp-1","input":[]}`)); err == nil {
+		t.Fatal("scope isolation failed")
+	}
+}
