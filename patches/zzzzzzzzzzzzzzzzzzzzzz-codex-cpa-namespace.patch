+				"tools": []map[string]any{
+					{"type": "function", "name": "get_me", "description": "Get current user", "parameters": map[string]any{"type": "object"}},
+					{"type": "custom", "name": "raw_query", "description": "Run a raw query"},
+				},
+			},
+		}),
+		Input: mustRawMessage(t, []map[string]any{
+			{"role": "user", "content": []map[string]any{{"type": "input_text", "text": "check"}}},
+			{
+				"type": "additional_tools",
+				"tools": []map[string]any{
+					{
+						"type":  "namespace",
+						"name":  "collaboration",
+						"tools": []map[string]any{{"type": "function", "name": "send_message", "parameters": map[string]any{"type": "object"}}},
+					},
+				},
+			},
+		}),
+	}
+
+	got, err := ResponsesRequestToChatCompletionsRequest(req)
+	require.NoError(t, err)
+	require.Len(t, got.Messages, 1, "additional_tools must not become an empty user message")
+	require.Len(t, got.Tools, 3)
+	assert.Equal(t, "mcp__github__get_me", got.Tools[0].Function.Name)
+	assert.Equal(t, "mcp__github__raw_query", got.Tools[1].Function.Name)
+	assert.Equal(t, "collaboration__send_message", got.Tools[2].Function.Name)
+
+	customParameters, ok := got.Tools[1].Function.Parameters.(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, "object", customParameters["type"])
+	assert.Equal(t, []string{"input"}, customParameters["required"])
+}
