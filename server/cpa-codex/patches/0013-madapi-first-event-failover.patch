+		return false
+	}
+	if callID, _ := item["call_id"].(string); strings.TrimSpace(callID) != "" {
+		return true
+	}
+	for _, key := range []string{"arguments", "input"} {
+		if text, _ := item[key].(string); strings.TrimSpace(text) != "" {
