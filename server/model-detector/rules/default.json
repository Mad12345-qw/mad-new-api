{
  "version": "2026.07.29.17",
  "implementation_rules": {
    "omniroute": {
      "source_urls": [
        "https://github.com/diegosouzapw/OmniRoute/blob/9c904ddf1cae799d1729779de53c02693c5da9a9/src/shared/constants/headers.ts",
        "https://github.com/diegosouzapw/OmniRoute/blob/9c904ddf1cae799d1729779de53c02693c5da9a9/docs/reference/API_REFERENCE.md",
        "https://github.com/diegosouzapw/OmniRoute/blob/9c904ddf1cae799d1729779de53c02693c5da9a9/docs/openapi.yaml"
      ]
    },
    "cliproxyapi": {
      "lookback_runs": 12,
      "trace_headers": ["x-cpa-trace-id"],
      "cors_expose_markers": [
        "x-cpa-version",
        "x-cpa-commit",
        "x-cpa-home-version",
        "x-cpa-support-plugin"
      ],
      "source_urls": [
        "https://github.com/router-for-me/CLIProxyAPI/blob/main/internal/logging/cpa_trace.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/main/internal/api/server_middleware.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/main/internal/runtime/executor/codex_executor_execute.go"
      ],
      "negative_reference_urls": [
        "https://github.com/QuantumNous/new-api/blob/main/relay/channel/codex/adaptor.go"
      ],
      "inventory_source_urls": [
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/registry/models/models.json",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/registry/model_definitions.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/sdk/api/handlers/openai/openai_images_handlers.go"
      ]
    }
  },
  "official_baselines": {
    "openai_responses": {
      "model_pattern": "^gpt-5(?:\\.|-)",
      "captured_at": "2026-07-29",
      "source_urls": [
        "https://developers.openai.com/api/docs/guides/model-guidance?model=gpt-5.6-sol",
        "https://developers.openai.com/api/docs/models/gpt-5.6-sol"
      ],
      "minimal_input_tokens": {
        "gpt-5.5": 9,
        "gpt-5.6-luna": 9,
        "gpt-5.6-sol": 9,
        "gpt-5.6-terra": 9
      },
      "normal_response": {
        "minimum_max_output_tokens": 16,
        "instructions": null,
        "prompt_cache_key": null,
        "safety_identifier": null,
        "prompt_cache_retention": "24h"
      },
      "contract_probes": [
        {
          "name": "openai_invalid_prompt_cache_retention",
          "field": "prompt_cache_retention",
          "value": "definitely-invalid",
          "expected_status": 400,
          "expected_error_code": "invalid_value",
          "expected_error_param": "prompt_cache_retention"
        },
        {
          "name": "openai_invalid_safety_identifier_type",
          "field": "safety_identifier",
          "value": {"bad": true},
          "expected_status": 400,
          "expected_error_code": "invalid_type",
          "expected_error_param": "safety_identifier"
        },
        {
          "name": "openai_invalid_prompt_cache_key_type",
          "field": "prompt_cache_key",
          "value": {"bad": true},
          "expected_status": 400,
          "expected_error_code": "invalid_type",
          "expected_error_param": "prompt_cache_key"
        },
        {
          "name": "openai_below_minimum_output_tokens",
          "field": "max_output_tokens",
          "value": 1,
          "expected_status": 400,
          "expected_error_code": "integer_below_min_value",
          "expected_error_param": "max_output_tokens"
        }
      ]
    },
    "gemini_generate": {
      "model": "gemini-3.6-flash",
      "model_version": "3.6-flash-07-2026",
      "captured_at": "2026-07-29",
      "input_token_limit": 1048576,
      "output_token_limit": 65536,
      "supported_generation_methods": [
        "generateContent",
        "countTokens",
        "createCachedContent",
        "batchGenerateContent"
      ],
      "source_urls": [
        "https://ai.google.dev/gemini-api/docs/models/gemini-3.6-flash",
        "https://ai.google.dev/api/models"
      ],
      "contract_probes": [
        {
          "name": "gemini_count_tokens",
          "operation": "countTokens",
          "expected_status": 200,
          "expected_response_key": "totalTokens"
        },
        {
          "name": "gemini_invalid_zero_output",
          "operation": "generateContent",
          "field": "generationConfig.maxOutputTokens",
          "expected_status": 400,
          "expected_error_status": "INVALID_ARGUMENT"
        },
        {
          "name": "gemini_invalid_unknown_field",
          "operation": "generateContent",
          "field": "modelDetectorInvalid",
          "expected_status": 400,
          "expected_error_status": "INVALID_ARGUMENT"
        },
        {
          "name": "gemini_invalid_safety_category",
          "operation": "generateContent",
          "field": "safetySettings.category",
          "expected_status": 400,
          "expected_error_status": "INVALID_ARGUMENT"
        },
        {
          "name": "gemini_missing_contents",
          "operation": "generateContent",
          "field": "contents",
          "expected_status": 400,
          "expected_error_status": "INVALID_ARGUMENT"
        }
      ]
    }
  },
  "history_rules": {
    "claude_route_change": {
      "lookback_runs": 12,
      "hidden_minimum_input_tokens": 2500,
      "hidden_minimum_cache_creation_tokens": 2000,
      "lightweight_maximum_input_tokens": 500,
      "lightweight_maximum_cache_creation_tokens": 500,
      "confidence": 0.93
    }
  },
  "subscription_relay_rules": {
    "codex": {
      "channel": "codex_subscription_relay",
      "model_pattern": "(^|[-_])gpt[-_].*|codex",
      "minimum_instruction_chars": 4000,
      "minimum_marker_matches": 3,
      "minimum_amplified_input_tokens": 1000,
      "source_urls": [
        "https://github.com/openai/codex/blob/fe01054a28fa4bd04716d9ceadb410f2443a50ce/codex-rs/models-manager/src/model_info.rs",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/runtime/executor/codex_executor_request.go"
      ],
      "instruction_markers": [
        "You are Codex, a coding agent based on GPT-5",
        "# Personality",
        "# Working with the user",
        "## Editing constraints",
        "## Autonomy and persistence"
      ]
    },
    "claude_code": {
      "channel": "claude_subscription_relay",
      "model_pattern": "claude",
      "minimum_cache_creation_tokens": 2000,
      "minimum_total_input_tokens": 2500,
      "system_probe_minimum_cache_creation_tokens": 1500,
      "system_probe_minimum_total_input_tokens": 2000,
      "source_urls": [
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/runtime/executor/claude_executor_request.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/runtime/executor/helps/claude_code_session.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/runtime/executor/claude_executor_cloaking.go",
        "https://github.com/router-for-me/CLIProxyAPI/blob/c9417c8ae9b16fabc0386ca35d36f13bf8b1d678/internal/runtime/executor/claude_executor_execute.go",
        "https://github.com/router-for-me/CLIProxyAPI/issues/4146",
        "https://github.com/router-for-me/CLIProxyAPI/issues/4383"
      ]
    },
    "antigravity": {
      "channel": "antigravity_subscription_relay",
      "model": "gemini-3.6-flash",
      "hidden_alias": "gemini-3.6-flash-high",
      "hidden_aliases": [
        "gemini-3.6-flash-high",
        "gemini-3.6-flash-medium",
        "gemini-3.6-flash-low",
        "gemini-3.6-flash-tiered"
      ],
      "minimum_successful_aliases_for_matrix": 2,
      "maximum_requested_output_tokens": 1,
      "minimum_rewritten_output_tokens": 4,
      "source_urls": [
        "https://github.com/router-for-me/CLIProxyAPI/blob/main/internal/registry/models/models.json",
        "https://github.com/router-for-me/CLIProxyAPI/blob/main/internal/runtime/executor/antigravity_executor_request.go",
        "https://github.com/router-for-me/CLIProxyAPI/issues/4504",
        "https://github.com/router-for-me/CLIProxyAPI/issues/4494",
        "https://github.com/heyhuynhgiabuu/proxypal/blob/main/src-tauri/src/utils.rs",
        "https://github.com/diegosouzapw/OmniRoute/blob/release/v3.8.50/open-sse/config/agyModels.ts",
        "https://github.com/lidge-jun/opencodex/blob/main/devlog/_fin/260722_gemini_36_rollout/001_research_contract.md"
      ]
    }
  },
  "domain_rules": [
    {"pattern": "(^|\\.)api\\.openai\\.com$", "channel": "openai_official", "title": "OpenAI 官方 API 域名"},
    {"pattern": "(^|\\.)api\\.anthropic\\.com$", "channel": "anthropic_official", "title": "Anthropic 官方 API 域名"},
    {"pattern": "(^|\\.)generativelanguage\\.googleapis\\.com$", "channel": "gemini_developer_api", "title": "Gemini Developer API 官方域名"},
    {"pattern": "(^|\\.)[a-z0-9-]+-aiplatform\\.googleapis\\.com$", "channel": "vertex_ai", "title": "Vertex AI 区域端点"},
    {"pattern": "(^|\\.)aiplatform\\.googleapis\\.com$", "channel": "vertex_ai", "title": "Vertex AI API 端点"},
    {"pattern": "(^|\\.)[a-z0-9-]+\\.openai\\.azure\\.com$", "channel": "azure_openai", "title": "Azure OpenAI 资源域名"},
    {"pattern": "^bedrock-runtime\\.[a-z0-9-]+\\.amazonaws\\.com$", "channel": "aws_bedrock", "title": "AWS Bedrock Runtime 域名"}
  ],
  "header_rules": [
    {"channel": "azure_openai", "all_headers": ["apim-request-id", "x-ms-region"], "strength": "strong", "title": "Azure APIM 响应头组合"},
    {"channel": "azure_openai", "all_headers": ["azureml-model-session"], "strength": "strong", "title": "Azure ML 会话响应头"},
    {"channel": "aws_bedrock", "all_headers": ["x-amzn-bedrock-invocation-latency"], "strength": "strong", "title": "Bedrock 调用响应头"},
    {"channel": "aws_bedrock", "all_headers": ["x-amzn-requestid"], "strength": "medium", "title": "AWS 请求标识响应头"},
    {"channel": "openai_official", "all_headers": ["openai-processing-ms", "x-request-id"], "strength": "strong", "title": "OpenAI 处理时间与请求标识头"},
    {"channel": "openai_official", "all_headers": ["x-ratelimit-limit-requests", "x-ratelimit-limit-tokens"], "strength": "medium", "title": "OpenAI 限流头组合"},
    {"channel": "anthropic_official", "all_headers": ["anthropic-ratelimit-requests-limit"], "strength": "strong", "title": "Anthropic 限流响应头"},
    {"channel": "vertex_ai", "all_headers": ["x-goog-request-params"], "strength": "medium", "title": "Google 资源路由响应头"}
  ],
  "error_rules": [
    {"channel": "azure_openai", "pattern": "\\b(DeploymentNotFound|DeploymentNotReady)\\b", "strength": "medium", "title": "Azure 部署错误契约"},
    {"channel": "aws_bedrock", "pattern": "\\b(ValidationException|ThrottlingException|ModelNotReadyException|AccessDeniedException)\\b", "strength": "medium", "title": "AWS Bedrock 异常类型"},
    {"channel": "vertex_ai", "pattern": "\\b(PublisherModel|projects/[a-z0-9_-]+/locations/[a-z0-9_-]+)\\b", "strength": "medium", "title": "Vertex AI 资源路径错误契约"}
  ]
}
