  "behavioral_distribution_rules": {
    "verdict_authority": "supporting_only",
    "official_reference_minimum_valid_samples_per_cell": 10,
    "minimum_cells_for_model_evidence": 8,
    "preferred_cells_for_model_evidence": 40,
    "probe_randomization": [
      "paraphrase_rotation",
      "cell_order_shuffle",
      "per_run_nonce"
    ],
    "sequential_dilution_audit": {
      "method": "betting_e_process",
      "null_tell_rate_ceiling": 0.05,
      "false_positive_level": 0.01,
      "stopping_wealth": 100.0,
      "maximum_queries": 200,
      "budget_exhausted_without_crossing": "inconclusive",
      "routing_fraction_reporting": "conservative_lower_bound"
    },
    "production_guards": {
      "hard_protocol_contradiction_overrides_behavior_match": true,
      "behavior_mismatch_cannot_identify_cloud_channel": true,
      "partial_official_baseline_is_diagnostic_only": true,
      "same_model_different_sampling_is_not_substitution": true,
      "multi_hop_sanitization_may_hide_terminal_channel": true
