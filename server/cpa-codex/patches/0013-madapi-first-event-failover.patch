+func madAPICodexStreamHasFirstEvent(chunks []cliproxyexecutor.StreamChunk) bool {
+	var stream bytes.Buffer
+	for _, chunk := range chunks {
+		stream.Write(chunk.Payload)
 		if !bytes.HasSuffix(chunk.Payload, []byte("\n")) {
-			_, _ = c.Writer.Write([]byte("\n"))
+			stream.WriteByte('\n')
+		}
+	}
+	for _, frame := range bytes.Split(stream.Bytes(), []byte("\n\n")) {
+		frame = bytes.TrimSpace(frame)
+		if len(frame) == 0 {
+			continue
+		}
+		eventType := ""
+		data := []byte(nil)
+		for _, line := range bytes.Split(frame, []byte("\n")) {
+			line = bytes.TrimSpace(line)
+			switch {
+			case bytes.HasPrefix(line, []byte("event:")):
+				eventType = strings.TrimSpace(string(bytes.TrimPrefix(line, []byte("event:"))))
+			case bytes.HasPrefix(line, []byte("data:")):
+				data = bytes.TrimSpace(bytes.TrimPrefix(line, []byte("data:")))
+			}
+		}
+		if len(data) == 0 || bytes.Equal(data, []byte("[DONE]")) {
+			continue
+		}
+		var value map[string]any
+		if json.Unmarshal(data, &value) != nil {
+			continue
+		}
+		if eventType == "" {
+			eventType, _ = value["type"].(string)
+		}
+		if eventType == "response.completed" || eventType == "response.failed" || eventType == "response.incomplete" {
+			return true
+		}
+		if strings.Contains(eventType, "output_text.delta") || strings.Contains(eventType, "reasoning") {
+			for _, key := range []string{"delta", "text", "summary", "arguments", "input"} {
+				if text, ok := value[key].(string); ok && strings.TrimSpace(text) != "" {
+					return true
+				}
+			}
+		}
+		if (strings.Contains(eventType, "function_call") || strings.Contains(eventType, "custom_tool_call")) && strings.HasSuffix(eventType, ".done") {
+			if callID, _ := value["call_id"].(string); strings.TrimSpace(callID) != "" {
+				return true
+			}
+			for _, key := range []string{"arguments", "input"} {
+				if text, ok := value[key].(string); ok && strings.TrimSpace(text) != "" {
+					return true
+				}
+			}
+		}
+		if eventType == "response.output_item.done" && madAPICodexHasCompletedToolCall(value) {
