+func applyMadAPIWebSearchOptions(translated, original []byte, auth *cliproxyauth.Auth, from sdktranslator.Format) []byte {
+	if auth == nil || auth.Attributes == nil || auth.Attributes["madapi_passthrough"] != "true" || from.String() != "openai-response" {
+		return translated
+	}
+	var options []byte
+	tools := gjson.GetBytes(original, "tools")
+	if !tools.IsArray() {
+		return translated
+	}
+	tools.ForEach(func(_, tool gjson.Result) bool {
+		switch strings.TrimSpace(tool.Get("type").String()) {
+		case "web_search", "web_search_preview", "web_search_preview_2025_03_11":
+			options = []byte(`{"search_context_size":"medium"}`)
+			if size := strings.TrimSpace(tool.Get("search_context_size").String()); size != "" {
+				options, _ = sjson.SetBytes(options, "search_context_size", size)
+			}
+			if location := tool.Get("user_location"); location.Exists() {
+				options, _ = sjson.SetRawBytes(options, "user_location", []byte(location.Raw))
+			}
+			return false
+		default:
+			return true
+		}
+	})
+	if len(options) == 0 {
+		return translated
+	}
+	updated, err := sjson.SetRawBytes(translated, "web_search_options", options)
+	if err != nil {
+		return translated
+	}
+	return updated
+}
