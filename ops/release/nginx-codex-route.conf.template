# This snippet belongs inside the public MadAPI server block.
# __NEW_API_UPSTREAM__ is the internal NewAPI URL without a trailing slash.
# __TRUSTED_ROUTE_TOKEN__ must match NewAPI's TRUSTED_ROUTE_TOKEN.

location ^~ /codex/v1/ {
    rewrite ^/codex/v1/(.*)$ /v1/$1 break;
    proxy_pass __NEW_API_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-New-Api-Route-Token "__TRUSTED_ROUTE_TOKEN__";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location ^~ /codex/cockpit/v1/ {
    rewrite ^/codex/cockpit/v1/(.*)$ /v1/$1 break;
    proxy_pass __NEW_API_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-New-Api-Route-Token "__TRUSTED_ROUTE_TOKEN__";
    proxy_set_header X-MadAPI-Codex-Cockpit "1";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location ^~ /v1/ {
    proxy_pass __NEW_API_UPSTREAM__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-New-Api-Route-Token "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
