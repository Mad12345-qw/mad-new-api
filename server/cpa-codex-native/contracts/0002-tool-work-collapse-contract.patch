+func TestConvertOpenAIChatCompletionsResponseToOpenAIResponses_SynthesizesReasoningEnvelopeForToolWork(t *testing.T) {
+	request := []byte(`{"model":"gpt-5.4","reasoning":{"effort":"medium"},"tools":[{"type":"function","name":"read","parameters":{"type":"object"}}]}`)
+	chunks := []string{
+		`data: {"id":"resp_reasoning_envelope","object":"chat.completion.chunk","created":1773896263,"model":"model","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call_read","type":"function","function":{"name":"read","arguments":""}}]},"finish_reason":null}]}`,
+		`data: {"id":"resp_reasoning_envelope","object":"chat.completion.chunk","created":1773896263,"model":"model","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"function":{"arguments":"{\"path\":\"README.md\"}"}}]},"finish_reason":"tool_calls"}]}`,
+		`data: [DONE]`,
+	}
+
+	var param any
+	events := make([]string, 0)
+	completed := gjson.Result{}
+	for _, line := range chunks {
+		for _, chunk := range ConvertOpenAIChatCompletionsResponseToOpenAIResponses(context.Background(), "model", request, request, []byte(line), &param) {
+			event, data := parseOpenAIResponsesSSEEvent(t, chunk)
+			events = append(events, event)
+			if event == "response.completed" {
+				completed = data
+			}
+		}
+	}
+
+	if len(events) == 0 || events[2] != "response.output_item.added" {
+		t.Fatalf("reasoning envelope was not emitted before tool work: %v", events)
+	}
+	if got := completed.Get("response.output.0.type").String(); got != "reasoning" {
+		t.Fatalf("completed output starts with %q, want reasoning; response=%s", got, completed.Raw)
+	}
+	if got := completed.Get("response.output.1.type").String(); got != "function_call" {
+		t.Fatalf("completed output second item = %q, want function_call; response=%s", got, completed.Raw)
+	}
+}
