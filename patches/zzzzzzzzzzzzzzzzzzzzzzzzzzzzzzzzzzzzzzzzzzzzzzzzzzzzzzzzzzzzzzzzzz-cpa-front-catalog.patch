diff --git a/middleware/distributor_madapi_test.go b/middleware/distributor_madapi_test.go
new file mode 100644
index 00000000..00000000
--- /dev/null
+++ b/middleware/distributor_madapi_test.go
@@ -0,0 +1,47 @@
+package middleware
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestIsMadAPICPAFrontRequest(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-secret")
+
+	tests := []struct {
+		name   string
+		header string
+		want   bool
+	}{
+		{name: "matching token", header: "front-secret", want: true},
+		{name: "wrong token", header: "wrong-secret", want: false},
+		{name: "missing token", header: "", want: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			context, _ := gin.CreateTestContext(httptest.NewRecorder())
+			context.Request = httptest.NewRequest("POST", "/v1/responses/compact", nil)
+			if test.header != "" {
+				context.Request.Header.Set("X-MadAPI-CPA-Front-Token", test.header)
+			}
+			if got := isMadAPICPAFrontRequest(context); got != test.want {
+				t.Fatalf("isMadAPICPAFrontRequest() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
+
+func TestIsMadAPICPAFrontRequestRejectsUnsetServerToken(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "")
+	context, _ := gin.CreateTestContext(httptest.NewRecorder())
+	context.Request = httptest.NewRequest("POST", "/v1/responses/compact", nil)
+	context.Request.Header.Set("X-MadAPI-CPA-Front-Token", "front-secret")
+	if isMadAPICPAFrontRequest(context) {
+		t.Fatal("expected an unset server token to reject CPA front routing")
+	}
+}
