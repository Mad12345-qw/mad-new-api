diff --git a/internal/runtime/executor/openai_compat_executor_madapi_test.go b/internal/runtime/executor/openai_compat_executor_madapi_test.go
new file mode 100644
index 00000000..698d1b0a
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_executor_madapi_test.go
@@ -0,0 +1,61 @@
+package executor
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestApplyMadAPIPassthroughAuthorization(t *testing.T) {
+	t.Run("replaces selector credential with caller authorization", func(t *testing.T) {
+		t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-token")
+		req := httptest.NewRequest("POST", "http://example.test/v1/responses", nil)
+		req.Header.Set("Authorization", "Bearer selector-key")
+		auth := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+		headers := req.Header.Clone()
+		headers.Set("X-MadAPI-Authorization", "Bearer caller-key")
+
+		if !applyMadAPIPassthroughAuthorization(req, auth, headers) {
+			t.Fatal("expected caller authorization to be accepted")
+		}
+		if got := req.Header.Get("Authorization"); got != "Bearer caller-key" {
+			t.Fatalf("Authorization = %q, want caller credential", got)
+		}
+		if got := req.Header.Get("X-MadAPI-CPA-Front-Token"); got != "front-token" {
+			t.Fatalf("X-MadAPI-CPA-Front-Token = %q, want internal token", got)
+		}
+	})
+
+	t.Run("rejects missing caller authorization for passthrough", func(t *testing.T) {
+		t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-token")
+		req := httptest.NewRequest("POST", "http://example.test/v1/responses", nil)
+		auth := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+		if applyMadAPIPassthroughAuthorization(req, auth, req.Header) {
+			t.Fatal("expected missing caller authorization to be rejected")
+		}
+	})
+
+	t.Run("rejects missing internal front token", func(t *testing.T) {
+		t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "")
+		req := httptest.NewRequest("POST", "http://example.test/v1/responses", nil)
+		auth := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+		headers := req.Header.Clone()
+		headers.Set("X-MadAPI-Authorization", "Bearer caller-key")
+		if applyMadAPIPassthroughAuthorization(req, auth, headers) {
+			t.Fatal("expected missing internal token to be rejected")
+		}
+	})
+
+	t.Run("leaves normal compatibility providers unchanged", func(t *testing.T) {
+		t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-token")
+		req := httptest.NewRequest("POST", "http://example.test/v1/responses", nil)
+		auth := &cliproxyauth.Auth{Attributes: map[string]string{}}
+		if !applyMadAPIPassthroughAuthorization(req, auth, req.Header) {
+			t.Fatal("expected normal provider to remain valid")
+		}
+		if got := req.Header.Get("X-MadAPI-CPA-Front-Token"); got != "" {
+			t.Fatalf("unexpected internal front token %q", got)
+		}
+	})
+}
