+func (e *ClaudeExecutor) executeCompact(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	compactRequest, err := buildClaudeCompactSummaryRequest(req.Payload, req.Model)
+	if err != nil {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadRequest, msg: err.Error()}
+	}
+
+	summaryReq := req
+	summaryReq.Payload = compactRequest
+	summaryOpts := opts
+	summaryOpts.Alt = ""
+	summaryOpts.Stream = false
+	summaryOpts.OriginalRequest = compactRequest
+	summaryResponse, err := e.Execute(ctx, auth, summaryReq, summaryOpts)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+
+	summary := claudeCompactSummaryText(summaryResponse.Payload)
+	if strings.TrimSpace(summary) == "" {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadGateway, msg: "Claude compaction returned an empty summary"}
+	}
+	responseID := "resp_claude_compaction_" + uuid.NewString()
+	itemID := "cmp_" + strings.TrimPrefix(responseID, "resp_")
+	encoded := claudeLocalCompactionPrefix + base64.RawURLEncoding.EncodeToString([]byte(summary))
+	out := []byte(`{"id":"","object":"response","created_at":0,"status":"completed","background":false,"error":null,"incomplete_details":null,"model":"","output":[{"id":"","type":"compaction","encrypted_content":""}]}`)
+	out, _ = sjson.SetBytes(out, "id", responseID)
+	out, _ = sjson.SetBytes(out, "created_at", time.Now().Unix())
+	out, _ = sjson.SetBytes(out, "model", req.Model)
+	out, _ = sjson.SetBytes(out, "output.0.id", itemID)
+	out, _ = sjson.SetBytes(out, "output.0.encrypted_content", encoded)
+	if usage := gjson.GetBytes(summaryResponse.Payload, "usage"); usage.Exists() {
+		out, _ = sjson.SetRawBytes(out, "usage", []byte(usage.Raw))
+	}
+	return cliproxyexecutor.Response{Payload: out, Headers: summaryResponse.Headers}, nil
+}
+
+func buildClaudeCompactSummaryRequest(payload []byte, model string) ([]byte, error) {
+	input := gjson.GetBytes(payload, "input")
+	request := []byte(`{"model":"","input":[],"stream":false,"max_output_tokens":4096}`)
+	request, _ = sjson.SetBytes(request, "model", model)
+	switch {
+	case input.IsArray():
+		request, _ = sjson.SetRawBytes(request, "input", []byte(input.Raw))
+	case input.Type == gjson.String:
+		message := []byte(`{"type":"message","role":"user","content":[{"type":"input_text","text":""}]}`)
+		message, _ = sjson.SetBytes(message, "content.0.text", input.String())
+		request, _ = sjson.SetRawBytes(request, "input.-1", message)
+	default:
+		return nil, fmt.Errorf("Claude compaction requires string or array input")
+	}
+
+	instruction := "Summarize the conversation for seamless continuation. Preserve user requirements, decisions, completed work, exact identifiers, tool results, unresolved problems, and the next concrete steps. Return only the summary."
+	if originalInstructions := strings.TrimSpace(gjson.GetBytes(payload, "instructions").String()); originalInstructions != "" {
+		instruction += "\n\nOriginal instructions that must remain in force:\n" + originalInstructions
+	}
+	message := []byte(`{"type":"message","role":"user","content":[{"type":"input_text","text":""}]}`)
+	message, _ = sjson.SetBytes(message, "content.0.text", instruction)
+	request, _ = sjson.SetRawBytes(request, "input.-1", message)
+	return request, nil
+}
+
+func claudeCompactSummaryText(payload []byte) string {
+	outputs := gjson.GetBytes(payload, "output")
+	if !outputs.IsArray() {
+		return ""
+	}
+	var parts []string
+	outputs.ForEach(func(_, output gjson.Result) bool {
+		content := output.Get("content")
+		if !content.IsArray() {
+			return true
+		}
+		content.ForEach(func(_, part gjson.Result) bool {
+			if part.Get("type").String() == "output_text" {
+				if text := strings.TrimSpace(part.Get("text").String()); text != "" {
+					parts = append(parts, text)
+				}
+			}
+			return true
+		})
+		return true
+	})
+	return strings.Join(parts, "\n")
+}
