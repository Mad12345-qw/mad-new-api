diff --git a/service/relayconvert/internal/oai_chat/responses_namespace.go b/service/relayconvert/internal/oai_chat/responses_namespace.go
new file mode 100644
index 0000000..9e08f59
--- /dev/null
+++ b/service/relayconvert/internal/oai_chat/responses_namespace.go
@@ -0,0 +1,165 @@
+package oaichat
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/dto"
+)
+
+type responsesToolDescriptor struct {
+	Name      string
+	Namespace string
+	Custom    bool
+}
+
+func responsesToolDescriptors(req *dto.OpenAIResponsesRequest) map[string]responsesToolDescriptor {
+	descriptors := make(map[string]responsesToolDescriptor)
+	if req == nil {
+		return descriptors
+	}
+
+	collect := func(value any) {
+		tools, err := responsesNamespaceToolsFromValue(value)
+		if err != nil {
+			return
+		}
+		for _, tool := range tools {
+			collectResponsesToolDescriptor(descriptors, tool, "")
+		}
+	}
+
+	if len(req.Tools) > 0 {
+		collect(json.RawMessage(req.Tools))
+	}
+	if len(req.Input) > 0 && common.GetJsonType(req.Input) == "array" {
+		var inputItems []map[string]any
+		if err := common.Unmarshal(req.Input, &inputItems); err == nil {
+			for _, item := range inputItems {
+				if strings.TrimSpace(common.Interface2String(item["type"])) == "additional_tools" {
+					collect(item["tools"])
+				}
+			}
+		}
+	}
+	return descriptors
+}
+
+func collectResponsesToolDescriptor(descriptors map[string]responsesToolDescriptor, tool map[string]any, namespace string) {
+	toolType := strings.TrimSpace(common.Interface2String(tool["type"]))
+	if toolType == "namespace" {
+		children, err := responsesNamespaceToolsFromValue(tool["tools"])
+		if err != nil {
+			return
+		}
+		namespaceName := strings.TrimSpace(common.Interface2String(tool["name"]))
+		for _, child := range children {
+			collectResponsesToolDescriptor(descriptors, child, namespaceName)
+		}
+		return
+	}
+	if toolType != "" && toolType != "function" && toolType != dto.CustomType {
+		return
+	}
+	name := responsesNamespaceToolName(tool)
+	qualifiedName := qualifyResponsesNamespaceName(namespace, name)
+	if qualifiedName == "" {
+		return
+	}
+	descriptors[qualifiedName] = responsesToolDescriptor{
+		Name:      name,
+		Namespace: strings.TrimSpace(namespace),
+		Custom:    toolType == dto.CustomType,
+	}
+}
+
+func responsesNamespaceToolsFromValue(value any) ([]map[string]any, error) {
+	if value == nil {
+		return nil, nil
+	}
+	var raw []byte
+	var err error
+	if message, ok := value.(json.RawMessage); ok {
+		raw = message
+	} else {
+		raw, err = common.Marshal(value)
+		if err != nil {
+			return nil, err
+		}
+	}
+	var tools []map[string]any
+	if err := common.Unmarshal(raw, &tools); err != nil {
+		return nil, err
+	}
+	return tools, nil
+}
+
+func responsesNamespaceToolName(tool map[string]any) string {
+	if name := strings.TrimSpace(common.Interface2String(tool["name"])); name != "" {
+		return name
+	}
+	if function, ok := tool["function"].(map[string]any); ok {
+		return strings.TrimSpace(common.Interface2String(function["name"]))
+	}
+	return ""
+}
+
+func qualifyResponsesNamespaceName(namespace, name string) string {
+	namespace = strings.TrimSpace(namespace)
+	name = strings.TrimSpace(name)
+	if namespace == "" || name == "" || strings.HasPrefix(name, "mcp__") || strings.HasPrefix(name, namespace+"__") {
+		return name
+	}
+	if strings.HasSuffix(namespace, "__") {
+		return namespace + name
+	}
+	return namespace + "__" + name
+}
+
+func restoreResponsesToolOutput(output *dto.ResponsesOutput, descriptors map[string]responsesToolDescriptor) {
+	if output == nil {
+		return
+	}
+	descriptor, ok := descriptors[strings.TrimSpace(output.Name)]
+	if !ok {
+		return
+	}
+	if descriptor.Custom {
+		output.Type = "custom_tool_call"
+		output.Input = unwrapResponsesCustomInput(output.Arguments)
+		output.Arguments = nil
+		return
+	}
+	output.Name = descriptor.Name
+	output.Namespace = descriptor.Namespace
+}
+
+func RestoreResponsesToolOutputs(resp *dto.OpenAIResponsesResponse, req *dto.OpenAIResponsesRequest) {
+	if resp == nil || req == nil {
+		return
+	}
+	descriptors := responsesToolDescriptors(req)
+	for index := range resp.Output {
+		restoreResponsesToolOutput(&resp.Output[index], descriptors)
+	}
+}
+
+func unwrapResponsesCustomInput(arguments json.RawMessage) json.RawMessage {
+	if len(arguments) == 0 {
+		return json.RawMessage(`""`)
+	}
+	argumentString := dto.ResponsesArgumentsString(arguments)
+	var wrapped map[string]any
+	if err := common.Unmarshal([]byte(argumentString), &wrapped); err == nil {
+		if input, ok := wrapped["input"]; ok {
+			if raw, err := common.Marshal(input); err == nil {
+				return raw
+			}
+		}
+	}
+	if raw, err := common.Marshal(argumentString); err == nil {
+		return raw
+	}
+	return json.RawMessage(`""`)
+}
