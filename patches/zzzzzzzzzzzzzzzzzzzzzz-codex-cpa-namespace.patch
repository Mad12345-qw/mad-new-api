+func prettyJSONForTest(raw []byte) string {
+	if !gjson.ValidBytes(raw) {
+		return string(raw)
+	}
+	var out bytes.Buffer
+	if err := json.Indent(&out, raw, "", "  "); err != nil {
+		return string(raw)
+	}
+	return out.String()
