+package controller
+
+import (
+	"crypto/subtle"
+	"os"
+	"sort"
+	"strings"
+
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+)
+
+const madAPIInternalCatalogTokenEnv = "MADAPI_INTERNAL_CATALOG_TOKEN"
+
+func madAPIInternalCatalogAuthorized(value string) bool {
+	expected := strings.TrimSpace(os.Getenv(madAPIInternalCatalogTokenEnv))
+	provided := strings.TrimSpace(value)
+	return expected != "" && len(expected) == len(provided) && subtle.ConstantTimeCompare([]byte(expected), []byte(provided)) == 1
+}
+
+// InternalCodexCatalog returns enabled text models to the private CPA front proxies.
+func InternalCodexCatalog(c *gin.Context) {
+	if !madAPIInternalCatalogAuthorized(c.GetHeader("X-MadAPI-Catalog-Token")) {
+		c.Status(404)
+		return
+	}
+
+	enabled := make(map[string]struct{})
+	for _, modelName := range model.GetEnabledModels() {
+		enabled[modelName] = struct{}{}
+	}
+
+	models := make([]dto.OpenAIModels, 0)
+	for _, pricing := range model.GetPricing() {
+		if pricing.QuotaType != 0 {
+			continue
+		}
+		if _, ok := enabled[pricing.ModelName]; !ok {
+			continue
+		}
+		models = append(models, buildOpenAIModel(pricing.ModelName, nil))
+	}
+	sort.Slice(models, func(i, j int) bool { return models[i].Id < models[j].Id })
+	c.JSON(200, gin.H{"object": "list", "data": models})
+}
