+func madAPICodexFirstEventTimeoutForModel(model string) time.Duration {
+	switch strings.ToLower(strings.TrimSpace(model)) {
+	case "gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna":
+		return 30 * time.Second
+	default:
+		return 0
+	}
+}
+
+func madAPICPADispatchClientForFirstEvent(model string) *http.Client {
+	timeout := madAPICodexFirstEventTimeoutForModel(model)
+	if timeout <= 0 {
+		return madAPICPADispatchClient
+	}
+	transport, ok := madAPICPADispatchClient.Transport.(*http.Transport)
+	if !ok || transport == nil {
+		return madAPICPADispatchClient
+	}
+	client := *madAPICPADispatchClient
+	attemptTransport := transport.Clone()
+	attemptTransport.ResponseHeaderTimeout = timeout
+	client.Transport = attemptTransport
+	return &client
+}
