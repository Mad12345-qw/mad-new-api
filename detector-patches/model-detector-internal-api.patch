diff --git a/router/model-detector-router.go b/router/model-detector-router.go
new file mode 100644
index 00000000..2460e37e
--- /dev/null
+++ b/router/model-detector-router.go
@@ -0,0 +1,31 @@
+package router
+
+import (
+	"crypto/subtle"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/QuantumNous/new-api/controller"
+	"github.com/gin-gonic/gin"
+)
+
+func modelDetectorServiceAuth() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		expected := strings.TrimSpace(os.Getenv("MODEL_DETECTOR_SERVICE_TOKEN"))
+		provided := strings.TrimSpace(c.GetHeader("X-Model-Detector-Token"))
+		if len(expected) < 32 || len(expected) != len(provided) || subtle.ConstantTimeCompare([]byte(expected), []byte(provided)) != 1 {
+			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"success": false, "message": "unauthorized"})
+			return
+		}
+		c.Next()
+	}
+}
+
+func registerModelDetectorRoutes(apiRouter *gin.RouterGroup) {
+	route := apiRouter.Group("/model-detector")
+	route.Use(modelDetectorServiceAuth())
+	route.GET("/health", controller.GetModelDetectorHealth)
+	route.GET("/channels", controller.GetModelDetectorChannels)
+	route.POST("/channels/:id/disable", controller.DisableChannelByModelDetector)
+}
diff --git a/router/model_detector_router_test.go b/router/model_detector_router_test.go
new file mode 100644
index 00000000..ccada95c
--- /dev/null
+++ b/router/model_detector_router_test.go
@@ -0,0 +1,38 @@
+package router
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestModelDetectorServiceAuthRequiresConfiguredMatchingToken(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	previous := os.Getenv("MODEL_DETECTOR_SERVICE_TOKEN")
+	t.Cleanup(func() { _ = os.Setenv("MODEL_DETECTOR_SERVICE_TOKEN", previous) })
+	require.NoError(t, os.Setenv("MODEL_DETECTOR_SERVICE_TOKEN", "unit-test-model-detector-service-token-123456"))
+	router := gin.New()
+	router.GET("/internal", modelDetectorServiceAuth(), func(c *gin.Context) {
+		c.JSON(http.StatusOK, gin.H{"success": true})
+	})
+
+	missing := httptest.NewRecorder()
+	router.ServeHTTP(missing, httptest.NewRequest(http.MethodGet, "/internal", nil))
+	require.Equal(t, http.StatusUnauthorized, missing.Code)
+
+	wrongRequest := httptest.NewRequest(http.MethodGet, "/internal", nil)
+	wrongRequest.Header.Set("X-Model-Detector-Token", "wrong-token-that-is-long-enough-but-does-not-match")
+	wrong := httptest.NewRecorder()
+	router.ServeHTTP(wrong, wrongRequest)
+	require.Equal(t, http.StatusUnauthorized, wrong.Code)
+
+	validRequest := httptest.NewRequest(http.MethodGet, "/internal", nil)
+	validRequest.Header.Set("X-Model-Detector-Token", "unit-test-model-detector-service-token-123456")
+	valid := httptest.NewRecorder()
+	router.ServeHTTP(valid, validRequest)
+	require.Equal(t, http.StatusOK, valid.Code)
+}
