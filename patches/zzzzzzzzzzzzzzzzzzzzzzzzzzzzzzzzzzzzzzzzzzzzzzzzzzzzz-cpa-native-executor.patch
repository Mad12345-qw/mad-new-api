@@ -0,0 +1,72 @@
+package relay
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	appconstant "github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/gjson"
+)
+
+func TestMadAPICodexNativeRequestRequiresLoopbackAndToken(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv(appconstant.MadAPICodexDispatchTokenEnv, "dispatch-secret")
+	req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"grok-4.5"}`))
+	req.RemoteAddr = "127.0.0.1:42000"
+	req.Header.Set(appconstant.MadAPICodexDispatchHeader, "dispatch-secret")
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = req
+	if !isMadAPICodexNativeRequest(c) {
+		t.Fatal("loopback request with matching token must use CPA native dispatch")
+	}
+	req.RemoteAddr = "198.51.100.20:42000"
+	if isMadAPICodexNativeRequest(c) {
+		t.Fatal("public request must not use CPA native dispatch")
+	}
+}
+
+func TestMadAPICodexDispatchPayloadPreservesSelectedChannel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"public-model","input":"hello","stream":true}`))
+	req.Header.Set("Content-Type", "application/json")
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = req
+	info := &relaycommon.RelayInfo{
+		IsStream:       true,
+		RelayMode:      relayconstant.RelayModeResponses,
+		RequestURLPath: "/v1/responses",
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ChannelType:       48,
+			ChannelId:         17,
+			ChannelBaseUrl:    "https://api.x.ai/v1",
+			ApiKey:            "provider-secret",
+			UpstreamModelName: "grok-4.5",
+			HeadersOverride:   map[string]interface{}{"X-Provider-Test": "yes"},
+			ParamOverride:     map[string]interface{}{"temperature": 0.2},
+			ChannelSetting:    dto.ChannelSettings{},
+		},
+	}
+
+	payload, err := madAPICodexDispatchPayload(c, info)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if payload.ChannelType != 48 || payload.ChannelID != 17 || payload.Model != "grok-4.5" || payload.APIKey != "provider-secret" {
+		t.Fatalf("selected channel not preserved: %#v", payload)
+	}
+	if got := gjson.GetBytes(payload.Body, "model").String(); got != "grok-4.5" {
+		t.Fatalf("upstream model = %q", got)
+	}
+	if got := gjson.GetBytes(payload.Body, "temperature").Float(); got != 0.2 {
+		t.Fatalf("temperature = %v", got)
+	}
+	if got := payload.Headers["x-provider-test"]; got != "yes" {
+		t.Fatalf("resolved header = %q", got)
+	}
+}
