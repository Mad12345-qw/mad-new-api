+		if err := common.Unmarshal(req.Tools, &tools); err != nil {
+			return nil, fmt.Errorf("invalid tools: %w", err)
+		}
+		toolGroups = append(toolGroups, tools)
+	}
+	if rawJSONPresent(req.Input) && common.GetJsonType(req.Input) == "array" {
+		var inputItems []map[string]any
+		if err := common.Unmarshal(req.Input, &inputItems); err != nil {
+			return nil, fmt.Errorf("invalid input: %w", err)
+		}
+		for _, item := range inputItems {
+			if strings.TrimSpace(common.Interface2String(item["type"])) != responsesInputTypeAdditionalTools {
+				continue
+			}
+			tools, err := responsesToolsFromValue(item["tools"])
+			if err != nil {
+				return nil, fmt.Errorf("invalid additional_tools: %w", err)
+			}
+			toolGroups = append(toolGroups, tools)
 		}
+	}
+
+	out := make([]dto.ToolCallRequest, 0)
+	for _, tools := range toolGroups {
+		for _, tool := range tools {
+			if err := appendResponsesToolToChat(&out, tool, ""); err != nil {
+				return nil, err
+			}
+		}
+	}
+	return out, nil
+}
 
+func appendResponsesToolToChat(out *[]dto.ToolCallRequest, tool map[string]any, namespace string) error {
+	toolType := strings.TrimSpace(common.Interface2String(tool["type"]))
+	switch toolType {
+	case "", "function":
+		name := qualifyResponsesNamespaceToolName(namespace, responsesToolName(tool))
+		if name == "" {
+			return nil
+		}
+		*out = append(*out, dto.ToolCallRequest{
+			Type: "function",
+			Function: dto.FunctionRequest{
+				Name:        name,
+				Description: responsesToolDescription(tool),
+				Parameters:  responsesToolParameters(tool),
+			},
+		})
+	case dto.CustomType:
+		name := qualifyResponsesNamespaceToolName(namespace, responsesToolName(tool))
+		if name == "" {
+			return nil
+		}
+		*out = append(*out, dto.ToolCallRequest{
+			Type: "function",
+			Function: dto.FunctionRequest{
+				Name:        name,
+				Description: responsesToolDescription(tool),
+				Parameters: map[string]any{
+					"type": "object",
+					"properties": map[string]any{
+						"input": map[string]any{"type": "string"},
+					},
+					"required": []string{"input"},
+				},
+			},
+		})
+	case "namespace":
+		children, err := responsesToolsFromValue(tool["tools"])
+		if err != nil {
+			return fmt.Errorf("invalid namespace tools: %w", err)
+		}
+		namespaceName := strings.TrimSpace(common.Interface2String(tool["name"]))
+		for _, child := range children {
+			if err := appendResponsesToolToChat(out, child, namespaceName); err != nil {
+				return err
+			}
+		}
+	default:
 		rawTool, err := common.Marshal(tool)
 		if err != nil {
-			return nil, err
+			return err
 		}
-		out = append(out, dto.ToolCallRequest{
-			Type:   toolType,
-			Custom: rawTool,
-		})
+		*out = append(*out, dto.ToolCallRequest{Type: toolType, Custom: rawTool})
 	}
-	return out, nil
+	return nil
+}
+
+func responsesToolsFromValue(value any) ([]map[string]any, error) {
+	if value == nil {
+		return nil, nil
+	}
+	raw, err := common.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	var tools []map[string]any
+	if err := common.Unmarshal(raw, &tools); err != nil {
+		return nil, err
+	}
+	return tools, nil
+}
+
+func responsesToolName(tool map[string]any) string {
+	if name := strings.TrimSpace(common.Interface2String(tool["name"])); name != "" {
+		return name
+	}
+	if function, ok := tool["function"].(map[string]any); ok {
+		return strings.TrimSpace(common.Interface2String(function["name"]))
+	}
+	return ""
+}
+
+func responsesToolDescription(tool map[string]any) string {
+	if description := common.Interface2String(tool["description"]); description != "" {
+		return description
+	}
+	if function, ok := tool["function"].(map[string]any); ok {
+		return common.Interface2String(function["description"])
+	}
+	return ""
+}
+
+func responsesToolParameters(tool map[string]any) any {
+	for _, key := range []string{"parameters", "parametersJsonSchema", "input_schema"} {
+		if parameters, ok := tool[key]; ok {
+			return parameters
+		}
+	}
+	if function, ok := tool["function"].(map[string]any); ok {
+		for _, key := range []string{"parameters", "parametersJsonSchema"} {
+			if parameters, ok := function[key]; ok {
+				return parameters
+			}
+		}
+	}
+	return map[string]any{}
+}
+
+func qualifyResponsesNamespaceToolName(namespace, name string) string {
+	namespace = strings.TrimSpace(namespace)
+	name = strings.TrimSpace(name)
+	if namespace == "" || name == "" || strings.HasPrefix(name, "mcp__") || strings.HasPrefix(name, namespace+"__") {
+		return name
+	}
+	if strings.HasSuffix(namespace, "__") {
+		return namespace + name
+	}
+	return namespace + "__" + name
 }
 
