+func isMadAPICodexInternalRequest(c *gin.Context) bool {
+	if c == nil || c.Request == nil {
+		return false
+	}
+	host, _, err := net.SplitHostPort(strings.TrimSpace(c.Request.RemoteAddr))
+	if err != nil {
+		host = strings.Trim(strings.TrimSpace(c.Request.RemoteAddr), "[]")
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return false
+	}
+	expected := strings.TrimSpace(os.Getenv(constant.MadAPICodexDispatchTokenEnv))
+	provided := strings.TrimSpace(c.GetHeader(constant.MadAPICodexDispatchHeader))
+	return expected != "" && len(expected) == len(provided) && subtle.ConstantTimeCompare([]byte(expected), []byte(provided)) == 1
+}
