diff --git a/sdk/cliproxy/auth/madapi_passthrough_test.go b/sdk/cliproxy/auth/madapi_passthrough_test.go
new file mode 100644
index 0000000..33dd8d2
--- /dev/null
+++ b/sdk/cliproxy/auth/madapi_passthrough_test.go
@@ -0,0 +1,66 @@
+package auth
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestPrepareMadAPIPassthroughAuth(t *testing.T) {
+	t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-token")
+	original := &Auth{
+		ID:       "native-provider",
+		Provider: "xai",
+		Attributes: map[string]string{
+			AttributeAPIKey:          "placeholder",
+			"madapi_passthrough":     "true",
+			"header:X-Provider-Test": "kept",
+		},
+	}
+	headers := http.Header{"X-Madapi-Authorization": {"Bearer caller-key"}}
+
+	prepared, err := prepareMadAPIPassthroughAuth(original, headers)
+	if err != nil {
+		t.Fatalf("prepareMadAPIPassthroughAuth() error = %v", err)
+	}
+	if prepared == original {
+		t.Fatal("expected request-scoped auth clone")
+	}
+	if got := prepared.Attributes[AttributeAPIKey]; got != "caller-key" {
+		t.Fatalf("prepared api_key = %q, want caller key", got)
+	}
+	if got := prepared.Attributes["header:X-MadAPI-CPA-Front-Token"]; got != "front-token" {
+		t.Fatalf("front token = %q, want configured token", got)
+	}
+	if got := original.Attributes[AttributeAPIKey]; got != "placeholder" {
+		t.Fatalf("shared auth mutated to %q", got)
+	}
+	if got := prepared.Attributes["header:X-Provider-Test"]; got != "kept" {
+		t.Fatalf("provider header = %q, want preserved", got)
+	}
+}
+
+func TestPrepareMadAPIPassthroughAuthRejectsMissingCaller(t *testing.T) {
+	t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "front-token")
+	auth := &Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+
+	prepared, err := prepareMadAPIPassthroughAuth(auth, nil)
+	if prepared != auth || err == nil {
+		t.Fatalf("prepareMadAPIPassthroughAuth() = (%v, %v), want request error", prepared, err)
+	}
+	if statusErr, ok := err.(*Error); !ok || statusErr.HTTPStatus != http.StatusUnauthorized || !statusErr.IsRequestScoped() {
+		t.Fatalf("error = %#v, want request-scoped unauthorized", err)
+	}
+}
+
+func TestPrepareMadAPIPassthroughAuthLeavesOrdinaryProvidersUntouched(t *testing.T) {
+	t.Setenv("MADAPI_INTERNAL_CATALOG_TOKEN", "")
+	auth := &Auth{Attributes: map[string]string{AttributeAPIKey: "ordinary"}}
+
+	prepared, err := prepareMadAPIPassthroughAuth(auth, nil)
+	if err != nil {
+		t.Fatalf("prepareMadAPIPassthroughAuth() error = %v", err)
+	}
+	if prepared != auth {
+		t.Fatal("ordinary provider should not be cloned")
+	}
+}
