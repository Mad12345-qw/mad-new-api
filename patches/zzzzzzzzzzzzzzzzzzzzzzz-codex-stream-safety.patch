+func writeCodexStreamFailure(c *gin.Context, state *codexStreamTerminalState, message string) error {
+	responseID := state.responseID
+	if responseID == "" {
+		responseID = fmt.Sprintf("resp_madapi_failed_%d", time.Now().UnixNano())
+	}
+	payload := map[string]any{
+		"type":            "response.failed",
+		"sequence_number": state.nextSequence,
+		"response": map[string]any{
+			"id":         responseID,
+			"object":     "response",
+			"created_at": time.Now().Unix(),
+			"status":     "failed",
+			"background": false,
+			"error": map[string]any{
+				"code":    "upstream_stream_ended",
+				"message": message,
+			},
+			"output": []any{},
+		},
+	}
+	raw, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	if _, err = fmt.Fprintf(c.Writer, "event: response.failed\ndata: %s\n\n", raw); err != nil {
+		return err
+	}
+	c.Writer.Flush()
+	return nil
