+		server.madAPINativeCodexExecuteWithFactory(c, func(*config.Config, string, int) (madAPINativeExecutor, string) {
+			return capture, "madapi-selected-channel"
+		})
+	})
+
+	serve := func(body string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(http.MethodPost, "/internal/madapi/codex/execute", strings.NewReader(body))
+		req.RemoteAddr = "127.0.0.1:41000"
+		req.Header.Set(madAPICodexDispatchHeader, "dispatch-secret")
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, req)
+		return recorder
+	}
+
+	first := `{"channel_type":1,"channel_id":8,"wire_protocol":"openai_chat_completions","base_url":"https://provider.example/v1","api_key":"provider-secret","model":"deepseek-v4-flash","session_scope":"user-scope-a","body":{"model":"deepseek-v4-flash","input":[{"type":"message","role":"user","content":"run tool"}]},"stream":false}`
+	if recorder := serve(first); recorder.Code != http.StatusOK {
+		t.Fatalf("first status = %d, body = %s", recorder.Code, recorder.Body.String())
+	}
+
+	continued := `{"channel_type":1,"channel_id":8,"wire_protocol":"openai_chat_completions","base_url":"https://provider.example/v1","api_key":"provider-secret","model":"deepseek-v4-flash","session_scope":"user-scope-a","body":{"model":"deepseek-v4-flash","previous_response_id":"resp-selected-channel","input":[{"type":"function_call_output","call_id":"call-1","output":"ok"}]},"stream":false}`
+	if recorder := serve(continued); recorder.Code != http.StatusOK {
+		t.Fatalf("continuation status = %d, body = %s", recorder.Code, recorder.Body.String())
+	}
+	got := string(capture.req.Payload)
+	for _, want := range []string{`"type":"reasoning"`, `"type":"function_call"`, `"type":"function_call_output"`} {
+		if !strings.Contains(got, want) {
