+type inlineThinkingSegment struct {
+	Text      string
+	Reasoning bool
+}
+
+func inlineThinkingMarkerPrefixSuffix(text string, marker string) int {
+	limit := len(marker) - 1
+	if len(text) < limit {
+		limit = len(text)
+	}
+	for size := limit; size > 0; size-- {
+		if strings.HasSuffix(text, marker[:size]) {
+			return size
+		}
+	}
+	return 0
+}
+
+func consumeInlineThinking(st *oaiToResponsesState, text string, final bool) ([]inlineThinkingSegment, bool) {
+	if st == nil {
+		return nil, false
+	}
+	wasActive := st.InlineThinking
+	hadPending := st.InlinePending != ""
+	input := st.InlinePending + text
+	st.InlinePending = ""
+	segments := make([]inlineThinkingSegment, 0, 3)
+	foundTag := false
+
+	appendSegment := func(value string, reasoning bool) {
+		if value == "" {
+			return
+		}
+		if len(segments) > 0 && segments[len(segments)-1].Reasoning == reasoning {
+			segments[len(segments)-1].Text += value
+			return
+		}
+		segments = append(segments, inlineThinkingSegment{Text: value, Reasoning: reasoning})
+	}
+
+	for input != "" {
+		marker := "<thinking>"
+		if st.InlineThinking {
+			marker = "</thinking>"
+		}
+		if index := strings.Index(input, marker); index >= 0 {
+			appendSegment(input[:index], st.InlineThinking)
+			input = input[index+len(marker):]
+			st.InlineThinking = !st.InlineThinking
+			foundTag = true
+			continue
+		}
+		if !final {
+			if size := inlineThinkingMarkerPrefixSuffix(input, marker); size > 0 {
+				appendSegment(input[:len(input)-size], st.InlineThinking)
+				st.InlinePending = input[len(input)-size:]
+				input = ""
+				break
+			}
+		}
+		appendSegment(input, st.InlineThinking)
+		input = ""
+	}
+
+	return segments, foundTag || wasActive || hadPending || st.InlineThinking || st.InlinePending != ""
+}
+
+func inlineThinkingText(text string) (reasoning string, visible string, found bool) {
+	state := &oaiToResponsesState{}
+	segments, handled := consumeInlineThinking(state, text, true)
+	if !handled {
+		return "", text, false
+	}
+	var reasoningText strings.Builder
+	var visibleText strings.Builder
+	for _, segment := range segments {
+		if segment.Reasoning {
+			reasoningText.WriteString(segment.Text)
+		} else {
+			visibleText.WriteString(segment.Text)
+		}
+	}
+	return reasoningText.String(), visibleText.String(), true
 }
 
