+		}
+		if choices, ok := value["choices"].([]any); ok {
+			for _, choice := range choices {
+				item, _ := choice.(map[string]any)
+				delta, _ := item["delta"].(map[string]any)
+				for _, key := range []string{"content", "reasoning_content"} {
+					if text, ok := delta[key].(string); ok && strings.TrimSpace(text) != "" {
+						return true
+					}
+				}
+			}
+		}
+	}
+	return false
+}
