+// isCodexForcedImageGenerationRequest deliberately requires an explicit image
+// tool choice. A normal conversation may advertise image_generation alongside
+// other tools; that decision still belongs to the selected conversation model.
+func isCodexForcedImageGenerationRequest(raw []byte) bool {
+	root := gjson.ParseBytes(raw)
+	if !root.Get("tools").IsArray() {
+		return false
+	}
+	hasImageTool := false
+	root.Get("tools").ForEach(func(_, tool gjson.Result) bool {
+		if strings.EqualFold(strings.TrimSpace(tool.Get("type").String()), "image_generation") &&
+			strings.EqualFold(strings.TrimSpace(tool.Get("action").String()), "generate") {
+			hasImageTool = true
+			return false
+		}
+		return true
+	})
+	if !hasImageTool {
+		return false
+	}
+	choice := root.Get("tool_choice")
+	if choice.Type == gjson.String {
+		return strings.EqualFold(strings.TrimSpace(choice.String()), "image_generation")
+	}
+	return strings.EqualFold(strings.TrimSpace(choice.Get("type").String()), "image_generation")
+}
+
+func proxyCodexImageGeneration(c *gin.Context, originalRequest []byte) error {
+	dispatchURL := strings.TrimSpace(os.Getenv(appconstant.MadAPICPAImageDispatchURLEnv))
+	if dispatchURL == "" {
+		dispatchURL = defaultCodexImageDispatchURL
+	}
+	if strings.TrimSpace(c.GetHeader(appconstant.MadAPICodexCockpitHeader)) == "1" {
+		dispatchURL = "http://cpa-codex-cockpit:8317/internal/madapi/codex/image"
+	}
+	req, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, dispatchURL, bytes.NewReader(originalRequest))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	if authorization := c.GetHeader("Authorization"); authorization != "" {
+		req.Header.Set("Authorization", authorization)
+	}
+	if token := strings.TrimSpace(os.Getenv(appconstant.MadAPICodexDispatchTokenEnv)); token != "" {
+		req.Header.Set(appconstant.MadAPICodexDispatchHeader, token)
+	}
+
+	resp, err := codexInternalHTTPClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("native image generation request failed: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		proxyCodexErrorResponse(c, resp)
+		return nil
+	}
+	copyCodexTraceHeaders(c, resp)
+	return proxyCodexNativeResponses(c, resp, originalRequest, gjson.GetBytes(originalRequest, "stream").Bool())
+}
