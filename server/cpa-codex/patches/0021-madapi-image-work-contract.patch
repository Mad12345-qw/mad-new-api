+func TestMadAPIWorkCollapseRequestMarksOnlyPassthroughRequests(t *testing.T) {
+	body := []byte(`{"model":"gpt-5.6-terra"}`)
+	passthrough := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+	if !gjson.GetBytes(madAPIWorkCollapseRequest(body, passthrough), "metadata.madapi_collapse_work").Bool() {
+		t.Fatal("MadAPI request was not marked for work collapse")
+	}
+	if gjson.GetBytes(madAPIWorkCollapseRequest(body, nil), "metadata.madapi_collapse_work").Exists() {
+		t.Fatal("non-MadAPI request must not be marked for work collapse")
+	}
+}
