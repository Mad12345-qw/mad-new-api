+type codexStreamTerminalState struct {
+	responseID   string
+	nextSequence int
+	terminal     bool
+}
+
+func (state *codexStreamTerminalState) observe(chunk []byte) {
+	var event string
+	var data []byte
+	for _, line := range bytes.Split(chunk, []byte("\n")) {
+		line = bytes.TrimSpace(line)
+		switch {
+		case bytes.HasPrefix(line, []byte("event:")):
+			event = strings.TrimSpace(string(bytes.TrimPrefix(line, []byte("event:"))))
+		case bytes.HasPrefix(line, []byte("data:")):
+			data = bytes.TrimSpace(bytes.TrimPrefix(line, []byte("data:")))
+		}
+	}
+	switch event {
+	case "response.completed", "response.failed", "response.incomplete":
+		state.terminal = true
+	}
+	if len(data) == 0 {
+		return
+	}
+	var envelope struct {
+		SequenceNumber int `json:"sequence_number"`
+		Response       struct {
+			ID string `json:"id"`
+		} `json:"response"`
+	}
+	if json.Unmarshal(data, &envelope) != nil {
+		return
+	}
+	if envelope.SequenceNumber >= state.nextSequence {
+		state.nextSequence = envelope.SequenceNumber + 1
+	}
+	if envelope.Response.ID != "" {
+		state.responseID = envelope.Response.ID
+	}
+}
