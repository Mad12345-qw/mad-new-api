+func TestMadAPICodexWireProtocolUsesModelAndChannelContract(t *testing.T) {
+	tests := []struct {
+		name        string
+		channelType int
+		model       string
+		baseURL     string
+		protocol    string
+		wantBaseURL string
+	}{
+		{"OpenAI GPT uses Responses", appconstant.ChannelTypeOpenAI, "gpt-5.6-sol", "https://gpt.example", madAPICodexProtocolOpenAIResponses, "https://gpt.example/v1"},
+		{"OpenAI Claude stays compatible", appconstant.ChannelTypeOpenAI, "claude-opus-5", "https://compat.example/v1/", madAPICodexProtocolOpenAIChat, "https://compat.example/v1"},
+		{"native Claude uses Messages", appconstant.ChannelTypeAnthropic, "claude-opus-5", "https://claude.example/v1", madAPICodexProtocolAnthropicMessages, "https://claude.example"},
+		{"native Gemini uses generateContent", appconstant.ChannelTypeGemini, "gemini-3.6-flash", "https://gemini.example/v1beta", madAPICodexProtocolGeminiGenerate, "https://gemini.example"},
+		{"native xAI uses Responses", appconstant.ChannelTypeXai, "grok-4.5", "https://xai.example", madAPICodexProtocolXAIResponses, "https://xai.example/v1"},
+		{"custom Kimi stays compatible", appconstant.ChannelTypeMoonshot, "kimi-k3", "https://kimi.example", madAPICodexProtocolOpenAIChat, "https://kimi.example/v1"},
+		{"DeepSeek stays compatible", appconstant.ChannelTypeDeepSeek, "deepseek-v4-flash", "https://deepseek.example/v1", madAPICodexProtocolOpenAIChat, "https://deepseek.example/v1"},
+		{"Codex channel uses Responses", appconstant.ChannelTypeCodex, "gpt-5.6-terra", "https://codex.example", madAPICodexProtocolOpenAIResponses, "https://codex.example/v1"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			protocol := madAPICodexWireProtocol(test.channelType, test.model)
+			if protocol != test.protocol {
+				t.Fatalf("protocol = %q, want %q", protocol, test.protocol)
+			}
+			if baseURL := madAPICodexBaseURLForProtocol(test.baseURL, protocol); baseURL != test.wantBaseURL {
+				t.Fatalf("base URL = %q, want %q", baseURL, test.wantBaseURL)
+			}
+		})
+	}
+}
