+func TestConvertOpenAIChatCompletionsResponseToOpenAIResponsesParsesSplitInlineThinking(t *testing.T) {
+	t.Parallel()
+	request := []byte(`{"model":"deepseek-v4-pro","stream":true}`)
+	chunks := [][]byte{
+		[]byte(`data: {"id":"resp_inline","object":"chat.completion.chunk","created":1773896263,"choices":[{"index":0,"delta":{"role":"assistant","content":"<thin"},"finish_reason":null}]}`),
+		[]byte(`data: {"id":"resp_inline","object":"chat.completion.chunk","created":1773896263,"choices":[{"index":0,"delta":{"content":"king>private chain</think"},"finish_reason":null}]}`),
+		[]byte(`data: {"id":"resp_inline","object":"chat.completion.chunk","created":1773896263,"choices":[{"index":0,"delta":{"content":"ing>public answer"},"finish_reason":"stop"}]}`),
+		[]byte(`data: [DONE]`),
+	}
+	var state any
+	var all strings.Builder
+	for _, chunk := range chunks {
+		for _, event := range ConvertOpenAIChatCompletionsResponseToOpenAIResponses(context.Background(), "deepseek-v4-pro", request, request, chunk, &state) {
+			all.Write(event)
+		}
+	}
+	output := all.String()
+	if strings.Contains(output, "<thinking>") || strings.Contains(output, "</thinking>") || strings.Contains(output, "<thin") {
+		t.Fatalf("inline thinking tags leaked into Responses stream: %s", output)
+	}
+	if !strings.Contains(output, `"type":"response.reasoning_summary_text.delta"`) || !strings.Contains(output, "private chain") {
+		t.Fatalf("reasoning event missing: %s", output)
+	}
+	if !strings.Contains(output, `"type":"response.output_text.delta"`) || !strings.Contains(output, "public answer") {
+		t.Fatalf("visible text event missing: %s", output)
+	}
+	if count := strings.Count(output, "event: response.completed"); count != 1 {
+		t.Fatalf("response.completed count = %d, want 1; output=%s", count, output)
+	}
+}
