+func TestMadAPICodexToolDeltaCommitsBeforeLegacyFrameLimit(t *testing.T) {
+	created := []cliproxyexecutor.StreamChunk{{Payload: []byte("event: response.created\ndata: {\"type\":\"response.created\"}\n\n")}}
+	for range 80 {
+		created = append(created, cliproxyexecutor.StreamChunk{Payload: []byte("event: response.in_progress\ndata: {\"type\":\"response.in_progress\"}\n\n")})
+	}
+	created = append(created, cliproxyexecutor.StreamChunk{Payload: []byte("event: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\"}\n\n")})
+	if !madAPICodexStreamHasFirstEvent(created) {
+		t.Fatal("tool delta after metadata frames must commit the stream")
+	}
+}
