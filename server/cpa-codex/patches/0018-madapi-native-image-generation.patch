+// madAPINativeCodexImage is the common CPA image bridge for both OAuth and
+// API-key Codex Desktop sessions. It deliberately calls MadAPI's image route
+// with the original user bearer token so channel selection and billing remain
+// entirely inside MadAPI rather than inside the CPA front proxy.
+func (s *Server) madAPINativeCodexImage(c *gin.Context) {
+	if !madAPICodexDispatchAuthorized(c.Request) {
+		c.Status(http.StatusNotFound)
+		return
+	}
+	raw, err := io.ReadAll(io.LimitReader(c.Request.Body, madAPICodexDispatchMaxBody+1))
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadRequest, fmt.Errorf("read image request: %w", err))
+		return
+	}
+	if len(raw) > madAPICodexDispatchMaxBody || !json.Valid(raw) {
+		writeMadAPINativeError(c, http.StatusBadRequest, errors.New("invalid image request JSON"))
+		return
+	}
+	imageRequest, responseModel, stream, err := madAPICodexImageRequest(raw)
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadRequest, err)
+		return
+	}
+	authorization := strings.TrimSpace(c.GetHeader("Authorization"))
+	if !strings.HasPrefix(strings.ToLower(authorization), "bearer ") {
+		writeMadAPINativeError(c, http.StatusUnauthorized, errors.New("MadAPI bearer token is required for image generation"))
+		return
+	}
+	baseURL := strings.TrimRight(strings.TrimSpace(os.Getenv(madAPIInternalURLEnv)), "/")
+	if baseURL == "" {
+		baseURL = "http://new-api:3000"
+	}
+	req, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, baseURL+"/v1/images/generations", bytes.NewReader(imageRequest))
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadGateway, err)
+		return
+	}
+	req.Header.Set("Authorization", authorization)
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := madAPIInternalHTTPClient.Do(req)
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadGateway, fmt.Errorf("MadAPI image request failed: %w", err))
+		return
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, madAPICodexImageResponseMaxBytes+1))
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadGateway, fmt.Errorf("read MadAPI image response: %w", err))
+		return
+	}
+	if len(body) > madAPICodexImageResponseMaxBytes {
+		writeMadAPINativeError(c, http.StatusBadGateway, errors.New("MadAPI image response exceeds the Codex image size limit"))
+		return
+	}
+	if resp.StatusCode != http.StatusOK {
+		copyMadAPIUpstreamHeaders(c.Writer.Header(), resp.Header)
+		if json.Valid(body) {
+			c.Data(resp.StatusCode, "application/json", body)
+			return
+		}
+		writeMadAPINativeError(c, resp.StatusCode, fmt.Errorf("MadAPI image request returned HTTP %d", resp.StatusCode))
+		return
+	}
+	images, err := madAPIImageResults(body)
+	if err != nil {
+		writeMadAPINativeError(c, http.StatusBadGateway, err)
+		return
+	}
+	copyMadAPIUpstreamHeaders(c.Writer.Header(), resp.Header)
+	writeMadAPICodexImageResponse(c, responseModel, images, stream)
+}
+
+type madAPICodexImageResult struct {
+	Base64       string
+	OutputFormat string
+	RevisedPrompt string
+}
+
+func madAPICodexImageRequest(raw []byte) ([]byte, string, bool, error) {
+	root := gjson.ParseBytes(raw)
+	if !root.Get("tools").IsArray() {
+		return nil, "", false, errors.New("image_generation tool is required")
+	}
+	var tool gjson.Result
+	root.Get("tools").ForEach(func(_, candidate gjson.Result) bool {
+		if strings.EqualFold(strings.TrimSpace(candidate.Get("type").String()), "image_generation") &&
+			strings.EqualFold(strings.TrimSpace(candidate.Get("action").String()), "generate") {
+			tool = candidate
+			return false
+		}
+		return true
+	})
+	if !tool.Exists() {
+		return nil, "", false, errors.New("generate image_generation tool is required")
+	}
+	choice := root.Get("tool_choice")
+	if !strings.EqualFold(strings.TrimSpace(choice.Get("type").String()), "image_generation") &&
+		!strings.EqualFold(strings.TrimSpace(choice.String()), "image_generation") {
+		return nil, "", false, errors.New("image_generation must be explicitly selected")
+	}
+	model := strings.TrimSpace(tool.Get("model").String())
+	if model == "" {
+		model = "gpt-image-2"
+	}
+	if !strings.EqualFold(model, "gpt-image-2") {
+		return nil, "", false, fmt.Errorf("unsupported Codex image tool model %q", model)
+	}
+	prompt := madAPICodexImagePrompt(root.Get("input"))
+	if prompt == "" {
+		return nil, "", false, errors.New("image prompt is required")
+	}
+	payload := []byte(`{"model":"gpt-image-2","prompt":"","response_format":"b64_json"}`)
+	payload, _ = sjson.SetBytes(payload, "prompt", prompt)
+	for _, field := range []string{"size", "quality", "background", "output_format", "moderation"} {
+		if value := strings.TrimSpace(tool.Get(field).String()); value != "" {
+			payload, _ = sjson.SetBytes(payload, field, value)
+		}
+	}
+	for _, field := range []string{"output_compression", "partial_images"} {
+		if value := tool.Get(field); value.Exists() && value.Type == gjson.Number {
+			payload, _ = sjson.SetBytes(payload, field, value.Int())
+		}
+	}
+	responseModel := strings.TrimSpace(root.Get("model").String())
+	if responseModel == "" {
+		responseModel = "gpt-5.4-mini"
+	}
+	return payload, responseModel, root.Get("stream").Bool(), nil
+}
+
+func madAPICodexImagePrompt(input gjson.Result) string {
+	if input.Type == gjson.String {
+		return strings.TrimSpace(input.String())
+	}
+	if !input.IsArray() {
+		return ""
+	}
+	prompt := ""
+	input.ForEach(func(_, item gjson.Result) bool {
+		if item.Type == gjson.String {
+			if value := strings.TrimSpace(item.String()); value != "" {
+				prompt = value
+			}
+			return true
+		}
+		if role := strings.TrimSpace(item.Get("role").String()); role != "" && !strings.EqualFold(role, "user") {
+			return true
+		}
+		if value := madAPICodexImageContent(item.Get("content")); value != "" {
+			prompt = value
+		}
+		return true
+	})
+	return prompt
+}
+
+func madAPICodexImageContent(content gjson.Result) string {
+	if content.Type == gjson.String {
+		return strings.TrimSpace(content.String())
+	}
+	if !content.IsArray() {
+		return ""
+	}
+	parts := make([]string, 0, content.Num)
+	content.ForEach(func(_, part gjson.Result) bool {
+		for _, field := range []string{"text", "input_text"} {
+			if value := strings.TrimSpace(part.Get(field).String()); value != "" {
+				parts = append(parts, value)
+				break
+			}
+		}
+		return true
+	})
+	return strings.TrimSpace(strings.Join(parts, "\n"))
+}
+
+func madAPIImageResults(body []byte) ([]madAPICodexImageResult, error) {
+	if !json.Valid(body) {
+		return nil, errors.New("MadAPI returned invalid image JSON")
+	}
+	data := gjson.GetBytes(body, "data")
+	if !data.IsArray() {
+		return nil, errors.New("MadAPI returned no image data")
+	}
+	results := make([]madAPICodexImageResult, 0, len(data.Array()))
+	data.ForEach(func(_, item gjson.Result) bool {
+		encoded := strings.TrimSpace(item.Get("b64_json").String())
+		if encoded == "" {
+			return true
+		}
+		results = append(results, madAPICodexImageResult{
+			Base64:        encoded,
+			OutputFormat:  strings.TrimSpace(item.Get("output_format").String()),
+			RevisedPrompt: strings.TrimSpace(item.Get("revised_prompt").String()),
+		})
+		return true
+	})
+	if len(results) == 0 {
+		return nil, errors.New("MadAPI image response did not contain base64 image data")
+	}
+	return results, nil
+}
+
+func writeMadAPICodexImageResponse(c *gin.Context, model string, images []madAPICodexImageResult, stream bool) {
+	responseID := fmt.Sprintf("resp_madapi_image_%d", time.Now().UnixNano())
+	output := make([]map[string]any, 0, len(images))
+	for index, image := range images {
+		format := image.OutputFormat
+		if format == "" {
+			format = "png"
+		}
+		item := map[string]any{
+			"id":            fmt.Sprintf("ig_%s_%d", responseID, index),
+			"type":          "image_generation_call",
+			"status":        "completed",
+			"result":        image.Base64,
+			"output_format": format,
+		}
+		if image.RevisedPrompt != "" {
+			item["revised_prompt"] = image.RevisedPrompt
+		}
+		output = append(output, item)
+	}
+	response := map[string]any{
+		"id":     responseID,
+		"object": "response",
+		"status": "completed",
+		"model":  model,
+		"output": output,
+	}
+	if !stream {
+		c.JSON(http.StatusOK, response)
+		return
+	}
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("Cache-Control", "no-cache")
+	c.Header("Connection", "keep-alive")
+	c.Status(http.StatusOK)
+	writeMadAPICodexImageEvent(c, "response.created", map[string]any{"type": "response.created", "response": map[string]any{"id": responseID, "object": "response", "status": "in_progress", "model": model}})
+	for index, item := range output {
+		writeMadAPICodexImageEvent(c, "response.output_item.added", map[string]any{"type": "response.output_item.added", "output_index": index, "item": map[string]any{"id": item["id"], "type": "image_generation_call", "status": "in_progress"}})
+		writeMadAPICodexImageEvent(c, "response.output_item.done", map[string]any{"type": "response.output_item.done", "output_index": index, "item": item})
+	}
+	writeMadAPICodexImageEvent(c, "response.completed", map[string]any{"type": "response.completed", "response": response})
+}
+
+func writeMadAPICodexImageEvent(c *gin.Context, event string, payload map[string]any) {
+	encoded, _ := json.Marshal(payload)
+	_, _ = fmt.Fprintf(c.Writer, "event: %s\ndata: %s\n\n", event, encoded)
+	c.Writer.Flush()
+}
