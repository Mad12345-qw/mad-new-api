+func codexCompatibilityLimit() int {
+	value := strings.TrimSpace(os.Getenv("MADAPI_CODEX_MAX_CONCURRENCY"))
+	limit, err := strconv.Atoi(value)
+	if err != nil || limit <= 0 {
+		return defaultCodexCompatibilityLimit
+	}
+	if limit > maxCodexCompatibilityLimit {
+		return maxCodexCompatibilityLimit
+	}
+	return limit
+}
+
+func acquireCodexCompatibilitySlot(c *gin.Context) bool {
+	if c == nil || c.Request == nil {
+		return false
+	}
+	select {
+	case codexCompatibilitySlots <- struct{}{}:
+		return true
+	case <-c.Request.Context().Done():
+		return false
+	}
+}
+
+func releaseCodexCompatibilitySlot() {
+	<-codexCompatibilitySlots
+}
