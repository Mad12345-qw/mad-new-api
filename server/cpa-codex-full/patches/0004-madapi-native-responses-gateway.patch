+func TestUseMadAPIResponsesPassthrough(t *testing.T) {
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+	if !useMadAPIResponsesPassthrough(auth, sdktranslator.FormatOpenAIResponse) {
+		t.Fatal("MadAPI Responses request must remain on the Responses protocol")
+	}
+	if useMadAPIResponsesPassthrough(auth, sdktranslator.FormatOpenAI) {
+		t.Fatal("Chat Completions requests must keep the compatibility path")
+	}
+	if useMadAPIResponsesPassthrough(&cliproxyauth.Auth{}, sdktranslator.FormatOpenAIResponse) {
+		t.Fatal("ordinary compatibility providers must not use MadAPI Responses passthrough")
+	}
+}
