[Unit]
Description=Mad API consecutive request error email monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=MAD_API_ALERT_RECIPIENT=huangzeyu66@qq.com
ExecStart=/usr/bin/python3 /usr/local/sbin/mad-api-error-alert.py
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mad-api-error-alert

