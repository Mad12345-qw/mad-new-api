[Unit]
Description=Mad API streaming image media gateway
After=network-online.target docker.service new-api.service
Wants=network-online.target

[Service]
Type=simple
User=imagecompat
Group=www-data
Environment=UPSTREAM=http://127.0.0.1:3001
Environment=PUBLIC_BASE_URL=https://mad.myddns.me
Environment=LISTEN_ADDRS=127.0.0.1:3013
Environment=CACHE_DIR=/opt/image-url-cache
Environment=SPOOL_DIR=/opt/image-media-gateway/spool
Environment=CACHE_TTL_SECONDS=1800
Environment=CACHE_MAX_BYTES=5368709120
Environment=MAX_IMAGE_BYTES=67108864
Environment=MAX_REQUEST_BYTES=100663296
Environment=MAX_RESPONSE_BYTES=100663296
Environment=GLOBAL_CONCURRENCY=100
Environment=URL_CONCURRENCY=100
Environment=INLINE_CONCURRENCY=1
Environment=QUEUE_TIMEOUT_SECONDS=300
Environment=UPSTREAM_TIMEOUT_SECONDS=360
Environment=DOWNLOAD_TIMEOUT_SECONDS=180
Environment=IDEMPOTENCY_TTL_SECONDS=1800
Environment=IDEMPOTENCY_MAX_ENTRIES=10000
Environment=FALLBACK_DEDUP_TTL_SECONDS=180
Environment=GOMEMLIMIT=192MiB
Environment=GOGC=50
ExecStart=/opt/image-media-gateway/image-media-gateway
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/image-url-cache /opt/image-media-gateway/spool
MemoryHigh=160M
MemoryMax=256M
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
