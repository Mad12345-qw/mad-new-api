+func TestBuildClaudeCompactSummaryRequestUsesSelectedModelAndTranscript(t *testing.T) {
+	payload := []byte(`{"model":"gpt-5.4","input":[{"type":"message","role":"user","content":"Keep CPA_COMPACT_SENTINEL"}],"instructions":"Preserve project rules"}`)
+	request, err := buildClaudeCompactSummaryRequest(payload, "gpt-5.4")
