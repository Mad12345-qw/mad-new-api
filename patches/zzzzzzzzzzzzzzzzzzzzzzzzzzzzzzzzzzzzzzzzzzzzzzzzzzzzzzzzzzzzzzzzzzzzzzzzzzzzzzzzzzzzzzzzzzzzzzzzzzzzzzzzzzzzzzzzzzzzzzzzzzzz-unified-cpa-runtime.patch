+func TestCodexCompatibilityCapacityQueuesInsteadOfRejecting(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	previous := codexCompatibilitySlots
+	codexCompatibilitySlots = make(chan struct{}, 1)
+	t.Cleanup(func() { codexCompatibilitySlots = previous })
+
+	first, _ := gin.CreateTestContext(httptest.NewRecorder())
+	first.Request = httptest.NewRequest(http.MethodPost, "/codex/v1/responses", nil)
+	require.True(t, acquireCodexCompatibilitySlot(first))
+
+	second, _ := gin.CreateTestContext(httptest.NewRecorder())
+	second.Request = httptest.NewRequest(http.MethodPost, "/codex/v1/responses", nil)
+	acquired := make(chan bool, 1)
+	go func() { acquired <- acquireCodexCompatibilitySlot(second) }()
+	select {
+	case <-acquired:
+		t.Fatal("second request bypassed the occupied capacity slot")
+	case <-time.After(30 * time.Millisecond):
+	}
+
+	releaseCodexCompatibilitySlot()
+	select {
+	case ok := <-acquired:
+		require.True(t, ok)
+	case <-time.After(time.Second):
+		t.Fatal("queued request was not admitted after capacity became available")
+	}
+	releaseCodexCompatibilitySlot()
+
+	codexCompatibilitySlots <- struct{}{}
+	canceled, _ := gin.CreateTestContext(httptest.NewRecorder())
+	request := httptest.NewRequest(http.MethodPost, "/codex/v1/responses", nil)
+	ctx, cancel := context.WithCancel(request.Context())
+	cancel()
+	canceled.Request = request.WithContext(ctx)
+	require.False(t, acquireCodexCompatibilitySlot(canceled))
+	releaseCodexCompatibilitySlot()
+}
