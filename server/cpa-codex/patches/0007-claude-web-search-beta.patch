 }
 
+func appendClaudeWebSearchBeta(body []byte, betas []string) []string {
+	tools := gjson.GetBytes(body, "tools")
+	if !tools.IsArray() {
+		return betas
+	}
+	usesWebSearch := false
+	tools.ForEach(func(_, tool gjson.Result) bool {
+		toolType := strings.ToLower(strings.TrimSpace(tool.Get("type").String()))
+		toolName := strings.ToLower(strings.TrimSpace(tool.Get("name").String()))
+		usesWebSearch = strings.HasPrefix(toolType, "web_search_") || toolName == "web_search"
+		return !usesWebSearch
+	})
+	if !usesWebSearch {
+		return betas
+	}
+	for _, beta := range betas {
+		if strings.TrimSpace(beta) == claudeWebSearchBeta {
+			return betas
+		}
+	}
+	return append(betas, claudeWebSearchBeta)
+}
