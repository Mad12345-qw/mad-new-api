+	}
+	if !exists {
+		c.JSON(http.StatusNotFound, gin.H{"error": gin.H{"message": "request_id was not found", "type": "invalid_request_error"}})
+		return
+	}
+	writeTaskIdempotencyReplay(c, reservation)
+}
