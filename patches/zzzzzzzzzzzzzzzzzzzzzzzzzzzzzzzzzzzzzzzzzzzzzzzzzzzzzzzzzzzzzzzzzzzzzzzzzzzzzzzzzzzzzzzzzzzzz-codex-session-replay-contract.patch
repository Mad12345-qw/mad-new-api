+func madAPICodexSessionScope(c *gin.Context) string {
+	if c == nil {
+		return ""
+	}
+	credential := strings.TrimSpace(c.GetHeader("Authorization"))
+	if credential == "" {
+		return ""
+	}
+	digest := sha256.Sum256([]byte(credential))
+	return hex.EncodeToString(digest[:])
