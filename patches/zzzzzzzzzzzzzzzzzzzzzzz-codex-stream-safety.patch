+func TestCodexStreamWritesFailureWhenUpstreamEndsWithoutDone(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/codex/v1/responses", nil)
+
+	upstream := strings.Join([]string{
+		`data: {"id":"chatcmpl-truncated","object":"chat.completion.chunk","created":1,"model":"gpt-test","choices":[{"index":0,"delta":{"role":"assistant","content":"partial"},"finish_reason":null}]}`,
+		"",
+	}, "\n")
+	resp := &http.Response{Body: io.NopCloser(strings.NewReader(upstream)), Header: make(http.Header)}
+
+	err := streamCodexCPAResponse(c, resp, "gpt-test", []byte(`{"model":"gpt-test","stream":true}`), nil)
+	require.NoError(t, err)
+	require.Contains(t, recorder.Body.String(), "event: response.failed")
+	require.Contains(t, recorder.Body.String(), `"code":"upstream_stream_ended"`)
+	require.NotContains(t, recorder.Body.String(), "event: response.completed")
+}
