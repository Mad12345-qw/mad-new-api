+func TestMadAPIResponseSessionTrimUsesByteBudgetAndLRU(t *testing.T) {
+	resetMadAPIResponseSessions()
+	now := time.Now()
+	oldest := madAPIResponseSessionState{input: []byte("123456"), updated: now.Add(-2 * time.Minute)}
+	newer := madAPIResponseSessionState{input: []byte("1234"), updated: now.Add(-time.Minute)}
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries["oldest"] = oldest
+	madAPIResponseSessions.entries["newer"] = newer
+	madAPIResponseSessions.totalBytes = madAPIResponseSessionStateBytes(oldest) + madAPIResponseSessionStateBytes(newer)
+	madAPIResponseSessionTrim(now, 3, 10, 5)
+	_, oldestExists := madAPIResponseSessions.entries["oldest"]
+	_, newerExists := madAPIResponseSessions.entries["newer"]
+	totalBytes := madAPIResponseSessions.totalBytes
+	madAPIResponseSessions.Unlock()
+
+	if oldestExists || !newerExists {
+		t.Fatal("byte-budget eviction did not remove the least recently used entry")
+	}
+	if totalBytes != 4 {
+		t.Fatalf("cache bytes = %d, want 4", totalBytes)
+	}
+}
