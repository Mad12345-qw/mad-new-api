diff --git a/sdk/api/handlers/openai/madapi_responses_session.go b/sdk/api/handlers/openai/madapi_responses_session.go
new file mode 100644
index 0000000..56ec854
--- /dev/null
+++ b/sdk/api/handlers/openai/madapi_responses_session.go
@@ -0,0 +1,313 @@
+package openai
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const (
+	// Keep MadAPI's plain Responses transcript separately from CPA's native
+	// Codex encrypted-signature replay cache. Third-party reasoning has no
+	// Codex signature, so it must never be put into that stricter cache.
+	madAPIResponseSessionTTL           = 1 * time.Hour
+	madAPIResponseSessionMaxBytes      = 16 << 20
+	madAPIResponseSessionMaxTotalBytes = 64 << 20
+	madAPIResponseSessionMaxItems      = 1024
+)
+
+type madAPIResponseSessionState struct {
+	input, output []byte
+	updated       time.Time
+}
+
+var madAPIResponseSessions = struct {
+	sync.Mutex
+	entries    map[string]madAPIResponseSessionState
+	totalBytes int
+}{entries: make(map[string]madAPIResponseSessionState)}
+
+func madAPIResponseSessionScope(request *http.Request) string {
+	if request == nil {
+		return ""
+	}
+	credential := strings.TrimSpace(request.Header.Get("X-MadAPI-Authorization"))
+	if credential == "" {
+		return ""
+	}
+	digest := sha256.Sum256([]byte(credential))
+	return hex.EncodeToString(digest[:])
+}
+
+func prepareMadAPIResponseSessionRequest(scope string, rawJSON []byte) ([]byte, error) {
+	if scope == "" {
+		return rawJSON, nil
+	}
+	modelName := madAPIResponseSessionModel(rawJSON)
+	if modelName == "" {
+		return rawJSON, nil
+	}
+	previousID := strings.TrimSpace(gjson.GetBytes(rawJSON, "previous_response_id").String())
+	if previousID == "" {
+		return restoreMadAPIResponseHistoryReasoning(scope, modelName, rawJSON)
+	}
+	state, ok := getMadAPIResponseSession(scope, modelName, previousID)
+	if !ok {
+		return nil, errors.New("Codex response context expired; compact or restart the conversation")
+	}
+	nextInput := gjson.GetBytes(rawJSON, "input")
+	if !nextInput.IsArray() {
+		return nil, errors.New("Codex continuation requires array input")
+	}
+	merged, err := mergeMadAPIResponseItems(state.input, state.output, []byte(nextInput.Raw))
+	if err != nil {
+		return nil, err
+	}
+	if len(merged) > madAPIResponseSessionMaxBytes {
+		return nil, errors.New("Codex response context exceeds the replay limit; compact the conversation")
+	}
+	prepared, err := sjson.SetRawBytes(rawJSON, "input", merged)
+	if err != nil {
+		return nil, err
+	}
+	return sjson.DeleteBytes(prepared, "previous_response_id")
+}
+
+// restoreMadAPIResponseHistoryReasoning supports Codex clients that continue a
+// conversation by resending the entire Responses transcript instead of using
+// previous_response_id. CPA's normal converter already preserves reasoning
+// items; this restores only the missing items emitted by an earlier CPA reply.
+func restoreMadAPIResponseHistoryReasoning(scope, modelName string, rawJSON []byte) ([]byte, error) {
+	input := gjson.GetBytes(rawJSON, "input")
+	if !input.IsArray() {
+		return rawJSON, nil
+	}
+
+	var inputItems []json.RawMessage
+	if err := json.Unmarshal([]byte(input.Raw), &inputItems); err != nil {
+		return nil, errors.New("decode Codex response transcript")
+	}
+
+	knownReasoning := make(map[string]struct{})
+	for _, item := range inputItems {
+		if gjson.GetBytes(item, "type").String() != "reasoning" {
+			continue
+		}
+		if id := strings.TrimSpace(gjson.GetBytes(item, "id").String()); id != "" {
+			knownReasoning[id] = struct{}{}
+		}
+	}
+
+	missingBefore := make(map[string][]json.RawMessage)
+	for _, state := range madAPIResponseSessionsForScope(scope, modelName) {
+		collectMadAPIResponseMissingReasoning(state.output, knownReasoning, missingBefore)
+	}
+	if len(missingBefore) == 0 {
+		return rawJSON, nil
+	}
+
+	prepared := make([]json.RawMessage, 0, len(inputItems)+len(missingBefore))
+	for _, item := range inputItems {
+		if anchor := madAPIResponseTranscriptAnchor(item); anchor != "" {
+			prepared = append(prepared, missingBefore[anchor]...)
+		}
+		prepared = append(prepared, item)
+	}
+	merged, err := json.Marshal(prepared)
+	if err != nil {
+		return nil, errors.New("encode Codex response transcript")
+	}
+	if len(merged) > madAPIResponseSessionMaxBytes {
+		return nil, errors.New("Codex response context exceeds the replay limit; compact the conversation")
+	}
+	return sjson.SetRawBytes(rawJSON, "input", merged)
+}
+
+func collectMadAPIResponseMissingReasoning(output []byte, known map[string]struct{}, missingBefore map[string][]json.RawMessage) {
+	var outputItems []json.RawMessage
+	if err := json.Unmarshal(output, &outputItems); err != nil {
+		return
+	}
+	pending := make([]json.RawMessage, 0)
+	for _, item := range outputItems {
+		if gjson.GetBytes(item, "type").String() == "reasoning" {
+			id := strings.TrimSpace(gjson.GetBytes(item, "id").String())
+			if id != "" {
+				if _, exists := known[id]; !exists {
+					pending = append(pending, item)
+				}
+			}
+			continue
+		}
+		anchor := madAPIResponseTranscriptAnchor(item)
+		if anchor == "" || len(pending) == 0 {
+			continue
+		}
+		missingBefore[anchor] = append(missingBefore[anchor], pending...)
+		pending = pending[:0]
+	}
+}
+
+func madAPIResponseTranscriptAnchor(item []byte) string {
+	itemType := strings.TrimSpace(gjson.GetBytes(item, "type").String())
+	switch itemType {
+	case "message":
+		if id := strings.TrimSpace(gjson.GetBytes(item, "id").String()); id != "" {
+			return "message:" + id
+		}
+	case "function_call", "custom_tool_call":
+		if callID := strings.TrimSpace(gjson.GetBytes(item, "call_id").String()); callID != "" {
+			return itemType + ":" + callID
+		}
+	}
+	return ""
+}
+
+func mergeMadAPIResponseItems(parts ...[]byte) ([]byte, error) {
+	items := make([]json.RawMessage, 0)
+	for _, part := range parts {
+		var current []json.RawMessage
+		if err := json.Unmarshal(part, &current); err != nil {
+			return nil, errors.New("decode Codex response transcript")
+		}
+		items = append(items, current...)
+	}
+	return json.Marshal(items)
+}
+
+func rememberMadAPIResponseSession(scope string, rawJSON, response []byte) {
+	if scope == "" {
+		return
+	}
+	if nested := gjson.GetBytes(response, "response"); gjson.GetBytes(response, "type").String() == "response.completed" && nested.IsObject() {
+		response = []byte(nested.Raw)
+	}
+	responseID := strings.TrimSpace(gjson.GetBytes(response, "id").String())
+	input := gjson.GetBytes(rawJSON, "input")
+	output := gjson.GetBytes(response, "output")
+	if responseID == "" || !input.IsArray() || !output.IsArray() || len(input.Raw)+len(output.Raw) > madAPIResponseSessionMaxBytes {
+		return
+	}
+	modelName := madAPIResponseSessionModel(rawJSON)
+	if modelName == "" {
+		return
+	}
+	if gjson.GetBytes(response, "output.0.type").String() == "compaction" {
+		input = gjson.Parse(`[]`)
+	}
+	now := time.Now()
+	madAPIResponseSessions.Lock()
+	defer madAPIResponseSessions.Unlock()
+	key := madAPIResponseSessionKey(scope, modelName, responseID)
+	if prior, exists := madAPIResponseSessions.entries[key]; exists {
+		madAPIResponseSessions.totalBytes -= madAPIResponseSessionStateBytes(prior)
+		delete(madAPIResponseSessions.entries, key)
+	}
+	state := madAPIResponseSessionState{input: bytes.Clone([]byte(input.Raw)), output: bytes.Clone([]byte(output.Raw)), updated: now}
+	madAPIResponseSessionTrim(now, madAPIResponseSessionMaxItems, madAPIResponseSessionMaxTotalBytes, madAPIResponseSessionStateBytes(state))
+	madAPIResponseSessions.entries[key] = state
+	madAPIResponseSessions.totalBytes += madAPIResponseSessionStateBytes(state)
+}
+
+func getMadAPIResponseSession(scope, modelName, responseID string) (madAPIResponseSessionState, bool) {
+	key := madAPIResponseSessionKey(scope, modelName, responseID)
+	if key == "" {
+		return madAPIResponseSessionState{}, false
+	}
+	now := time.Now()
+	madAPIResponseSessions.Lock()
+	defer madAPIResponseSessions.Unlock()
+	state, ok := madAPIResponseSessions.entries[key]
+	if !ok || now.Sub(state.updated) > madAPIResponseSessionTTL {
+		if ok {
+			madAPIResponseSessions.totalBytes -= madAPIResponseSessionStateBytes(state)
+			delete(madAPIResponseSessions.entries, key)
+		}
+		return madAPIResponseSessionState{}, false
+	}
+	state.updated = now
+	madAPIResponseSessions.entries[key] = state
+	state.input, state.output = bytes.Clone(state.input), bytes.Clone(state.output)
+	return state, true
+}
+
+func madAPIResponseSessionsForScope(scope, modelName string) []madAPIResponseSessionState {
+	prefix := madAPIResponseSessionScopePrefix(scope, modelName)
+	now := time.Now()
+	madAPIResponseSessions.Lock()
+	defer madAPIResponseSessions.Unlock()
+	states := make([]madAPIResponseSessionState, 0)
+	for key, state := range madAPIResponseSessions.entries {
+		if now.Sub(state.updated) > madAPIResponseSessionTTL {
+			madAPIResponseSessions.totalBytes -= madAPIResponseSessionStateBytes(state)
+			delete(madAPIResponseSessions.entries, key)
+			continue
+		}
+		if strings.HasPrefix(key, prefix) {
+			states = append(states, madAPIResponseSessionState{
+				input:   bytes.Clone(state.input),
+				output:  bytes.Clone(state.output),
+				updated: state.updated,
+			})
+		}
+	}
+	return states
+}
+
+func madAPIResponseSessionStateBytes(state madAPIResponseSessionState) int {
+	return len(state.input) + len(state.output)
+}
+
+// madAPIResponseSessionTrim enforces the process-local cache budget before a
+// new session is inserted. The least recently used entry is evicted first.
+func madAPIResponseSessionTrim(now time.Time, maxItems, maxTotalBytes, reservedBytes int) {
+	for key, state := range madAPIResponseSessions.entries {
+		if now.Sub(state.updated) > madAPIResponseSessionTTL {
+			madAPIResponseSessions.totalBytes -= madAPIResponseSessionStateBytes(state)
+			delete(madAPIResponseSessions.entries, key)
+		}
+	}
+	for len(madAPIResponseSessions.entries) >= maxItems || madAPIResponseSessions.totalBytes+reservedBytes > maxTotalBytes {
+		oldestKey := ""
+		var oldest time.Time
+		for key, state := range madAPIResponseSessions.entries {
+			if oldestKey == "" || state.updated.Before(oldest) {
+				oldestKey, oldest = key, state.updated
+			}
+		}
+		if oldestKey == "" {
+			return
+		}
+		state := madAPIResponseSessions.entries[oldestKey]
+		madAPIResponseSessions.totalBytes -= madAPIResponseSessionStateBytes(state)
+		delete(madAPIResponseSessions.entries, oldestKey)
+	}
+}
+
+func madAPIResponseSessionModel(rawJSON []byte) string {
+	return strings.TrimSpace(gjson.GetBytes(rawJSON, "model").String())
+}
+
+func madAPIResponseSessionScopePrefix(scope, modelName string) string {
+	if strings.TrimSpace(scope) == "" || strings.TrimSpace(modelName) == "" {
+		return ""
+	}
+	return scope + "\x00" + modelName + "\x00"
+}
+
+func madAPIResponseSessionKey(scope, modelName, responseID string) string {
+	prefix := madAPIResponseSessionScopePrefix(scope, modelName)
+	if prefix == "" || strings.TrimSpace(responseID) == "" {
+		return ""
+	}
+	return prefix + responseID
+}
diff --git a/sdk/api/handlers/openai/madapi_responses_session_test.go b/sdk/api/handlers/openai/madapi_responses_session_test.go
new file mode 100644
index 0000000..8858a58
--- /dev/null
+++ b/sdk/api/handlers/openai/madapi_responses_session_test.go
@@ -0,0 +1,183 @@
+package openai
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func resetMadAPIResponseSessions() {
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries = make(map[string]madAPIResponseSessionState)
+	madAPIResponseSessions.totalBytes = 0
+	madAPIResponseSessions.Unlock()
+}
+
+func TestMadAPIResponseSessionReplaysReasoningAndToolCall(t *testing.T) {
+	resetMadAPIResponseSessions()
+	first := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"run tool"}]}`)
+	response := []byte(`{"id":"resp-1","output":[{"type":"reasoning","id":"rs-1"},{"type":"function_call","call_id":"call-1","name":"lookup","arguments":"{}"}]}`)
+	rememberMadAPIResponseSession("scope-a", first, response)
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"deepseek-v4","previous_response_id":"resp-1","input":[{"type":"function_call_output","call_id":"call-1","output":"ok"}]}`))
+	if err != nil {
+		t.Fatalf("prepare continuation: %v", err)
+	}
+	for _, want := range []string{`"type":"reasoning"`, `"type":"function_call"`, `"type":"function_call_output"`} {
+		if !strings.Contains(string(continued), want) {
+			t.Fatalf("continuation lost %s: %s", want, continued)
+		}
+	}
+	if strings.Contains(string(continued), "previous_response_id") {
+		t.Fatalf("provider state leaked: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionIsTokenScoped(t *testing.T) {
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[]}`))
+	if _, err := prepareMadAPIResponseSessionRequest("scope-b", []byte(`{"model":"deepseek-v4","previous_response_id":"resp-1","input":[]}`)); err == nil {
+		t.Fatal("scope isolation failed")
+	}
+}
+
+func TestMadAPIResponseSessionStoresCompletedSSEEvent(t *testing.T) {
+	resetMadAPIResponseSessions()
+	request := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"run tool"}]}`)
+	event := []byte(`{"type":"response.completed","response":{"id":"resp-stream","output":[{"type":"reasoning","id":"rs-1"},{"type":"function_call","call_id":"call-1","name":"lookup","arguments":"{}"}]}}`)
+	rememberMadAPIResponseSession("scope-a", request, event)
+	if _, ok := getMadAPIResponseSession("scope-a", "deepseek-v4", "resp-stream"); !ok {
+		t.Fatal("completed SSE response was not stored")
+	}
+}
+
+func TestMadAPIResponseSessionDropsPreCompactionTranscript(t *testing.T) {
+	resetMadAPIResponseSessions()
+	request := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"large history"}]}`)
+	response := []byte(`{"id":"resp-compact","output":[{"type":"compaction","encrypted_content":"summary"}]}`)
+	rememberMadAPIResponseSession("scope-a", request, response)
+	state, ok := getMadAPIResponseSession("scope-a", "deepseek-v4", "resp-compact")
+	if !ok {
+		t.Fatal("compaction response was not stored")
+	}
+	if string(state.input) != "[]" {
+		t.Fatalf("stored pre-compaction input = %s, want []", state.input)
+	}
+}
+
+func TestMadAPIResponseSessionRestoresReasoningForFullHistory(t *testing.T) {
+	resetMadAPIResponseSessions()
+	first := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"first"}]}`)
+	response := []byte(`{"id":"resp-1","output":[{"id":"rs-1","type":"reasoning","summary":[{"type":"summary_text","text":"private reasoning"}]},{"id":"msg-1","type":"message","role":"assistant","content":[{"type":"output_text","text":"answer"}]}]}`)
+	rememberMadAPIResponseSession("scope-a", first, response)
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"first"},{"id":"msg-1","type":"message","role":"assistant","content":[{"type":"output_text","text":"answer"}]},{"type":"message","role":"user","content":"second"}]}`))
+	if err != nil {
+		t.Fatalf("prepare full-history continuation: %v", err)
+	}
+	reasoningIndex := strings.Index(string(continued), `"id":"rs-1"`)
+	messageIndex := strings.Index(string(continued), `"id":"msg-1"`)
+	if reasoningIndex < 0 || messageIndex < 0 || reasoningIndex > messageIndex {
+		t.Fatalf("reasoning was not restored before the matching message: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionDoesNotDuplicateHistoryReasoning(t *testing.T) {
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[{"id":"rs-1","type":"reasoning"},{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"deepseek-v4","input":[{"id":"rs-1","type":"reasoning"},{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+	if err != nil {
+		t.Fatalf("prepare full-history continuation: %v", err)
+	}
+	if strings.Count(string(continued), `"id":"rs-1"`) != 1 {
+		t.Fatalf("reasoning was duplicated: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionRestoresReasoningOnlyInsideTokenScope(t *testing.T) {
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[{"id":"rs-1","type":"reasoning"},{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+	continued, err := prepareMadAPIResponseSessionRequest("scope-b", []byte(`{"model":"deepseek-v4","input":[{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+	if err != nil {
+		t.Fatalf("prepare full-history continuation: %v", err)
+	}
+	if strings.Contains(string(continued), `"id":"rs-1"`) {
+		t.Fatalf("foreign token reasoning was restored: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionIsModelScoped(t *testing.T) {
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[{"id":"rs-1","type":"reasoning"},{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+
+	if _, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"grok-4.5","previous_response_id":"resp-1","input":[]}`)); err == nil {
+		t.Fatal("previous_response_id crossed model boundary")
+	}
+
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"grok-4.5","input":[{"id":"msg-1","type":"message","role":"assistant","content":[]}]}`))
+	if err != nil {
+		t.Fatalf("prepare cross-model full history: %v", err)
+	}
+	if strings.Contains(string(continued), `"id":"rs-1"`) {
+		t.Fatalf("reasoning crossed model boundary: %s", continued)
+	}
+}
+
+func TestMadAPIResponseSessionKeepsOneHourReplayWindow(t *testing.T) {
+	if madAPIResponseSessionTTL != time.Hour {
+		t.Fatalf("replay TTL = %s, want %s", madAPIResponseSessionTTL, time.Hour)
+	}
+	resetMadAPIResponseSessions()
+	rememberMadAPIResponseSession("scope-a", []byte(`{"model":"deepseek-v4","input":[]}`), []byte(`{"id":"resp-1","output":[]}`))
+
+	key := madAPIResponseSessionKey("scope-a", "deepseek-v4", "resp-1")
+	madAPIResponseSessions.Lock()
+	state := madAPIResponseSessions.entries[key]
+	state.updated = time.Now().Add(-59 * time.Minute)
+	madAPIResponseSessions.entries[key] = state
+	madAPIResponseSessions.Unlock()
+
+	if _, ok := getMadAPIResponseSession("scope-a", "deepseek-v4", "resp-1"); !ok {
+		t.Fatal("replay entry expired before one hour")
+	}
+}
+
+func TestMadAPIResponseSessionTrimUsesByteBudgetAndLRU(t *testing.T) {
+	resetMadAPIResponseSessions()
+	now := time.Now()
+	oldest := madAPIResponseSessionState{input: []byte("123456"), updated: now.Add(-2 * time.Minute)}
+	newer := madAPIResponseSessionState{input: []byte("1234"), updated: now.Add(-time.Minute)}
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries["oldest"] = oldest
+	madAPIResponseSessions.entries["newer"] = newer
+	madAPIResponseSessions.totalBytes = madAPIResponseSessionStateBytes(oldest) + madAPIResponseSessionStateBytes(newer)
+	madAPIResponseSessionTrim(now, 3, 10, 5)
+	_, oldestExists := madAPIResponseSessions.entries["oldest"]
+	_, newerExists := madAPIResponseSessions.entries["newer"]
+	totalBytes := madAPIResponseSessions.totalBytes
+	madAPIResponseSessions.Unlock()
+
+	if oldestExists || !newerExists {
+		t.Fatal("byte-budget eviction did not remove the least recently used entry")
+	}
+	if totalBytes != 4 {
+		t.Fatalf("cache bytes = %d, want 4", totalBytes)
+	}
+}
+
+func TestMadAPIResponseSessionTrimUsesItemLimit(t *testing.T) {
+	resetMadAPIResponseSessions()
+	now := time.Now()
+	oldest := madAPIResponseSessionState{input: []byte("old"), updated: now.Add(-2 * time.Minute)}
+	newer := madAPIResponseSessionState{input: []byte("new"), updated: now.Add(-time.Minute)}
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries["oldest"] = oldest
+	madAPIResponseSessions.entries["newer"] = newer
+	madAPIResponseSessions.totalBytes = madAPIResponseSessionStateBytes(oldest) + madAPIResponseSessionStateBytes(newer)
+	madAPIResponseSessionTrim(now, 2, 100, 3)
+	_, oldestExists := madAPIResponseSessions.entries["oldest"]
+	_, newerExists := madAPIResponseSessions.entries["newer"]
+	madAPIResponseSessions.Unlock()
+
+	if oldestExists || !newerExists {
+		t.Fatal("item-limit eviction did not remove the least recently used entry")
+	}
+}
