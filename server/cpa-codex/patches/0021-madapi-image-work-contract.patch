+func TestEnsureImageGenerationTool_MadAPIPassthroughResponsesLiteInjectsTool(t *testing.T) {
+	body := []byte(`{"model":"gpt-5.6-terra","input":"draw"}`)
+	headers := make(http.Header)
+	headers.Set("X-OpenAI-Internal-Codex-Responses-Lite", "true")
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"madapi_passthrough": "true"}}
+
+	result := ensureImageGenerationTool(body, "gpt-5.6-terra", auth, headers)
+	if got := gjson.GetBytes(result, "tools.0.type").String(); got != "image_generation" {
+		t.Fatalf("tools.0.type = %q, want image_generation; body=%s", got, result)
+	}
+}
