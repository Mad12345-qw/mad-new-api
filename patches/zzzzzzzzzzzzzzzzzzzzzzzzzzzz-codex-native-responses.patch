+	}
+	if got := gjson.GetBytes(out, "type").String(); got != "response.custom_tool_call_input.done" {
+		t.Fatalf("event type = %q", got)
+	}
+	if got := gjson.GetBytes(out, "input").String(); got != "patch" {
+		t.Fatalf("input = %q", got)
+	}
+}
