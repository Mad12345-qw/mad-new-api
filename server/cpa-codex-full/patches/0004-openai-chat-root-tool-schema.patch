+func TestConvertOpenAIResponsesRequestToOpenAIChatCompletions_NormalizesRootToolSchemaUnion(t *testing.T) {
+	raw := []byte(`{
+		"input":[{"role":"user","content":"schedule it"}],
+		"tools":[{
+			"type":"function",
+			"name":"automation_update",
+			"parameters":{
+				"anyOf":[
+					{"type":"object","properties":{"mode":{"type":"string"}}},
+					{"type":"string"}
+				]
+			}
+		}]
+	}`)
+
+	out := ConvertOpenAIResponsesRequestToOpenAIChatCompletions("grok-4.5", raw, false)
+	schema := gjson.GetBytes(out, "tools.0.function.parameters")
+	if got := schema.Get("type").String(); got != "object" {
+		t.Fatalf("parameters type = %q, want object; output=%s", got, out)
+	}
+	if schema.Get("anyOf").Exists() {
+		t.Fatalf("root anyOf must be removed; output=%s", out)
+	}
+	if got := schema.Get("properties.mode.type").String(); got != "string" {
+		t.Fatalf("object branch properties were lost; output=%s", out)
+	}
+}
