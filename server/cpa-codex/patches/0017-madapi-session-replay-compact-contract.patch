+func TestMadAPIResponseSessionTrimUsesItemLimit(t *testing.T) {
+	resetMadAPIResponseSessions()
+	now := time.Now()
+	oldest := madAPIResponseSessionState{input: []byte("old"), updated: now.Add(-2 * time.Minute)}
+	newer := madAPIResponseSessionState{input: []byte("new"), updated: now.Add(-time.Minute)}
+	madAPIResponseSessions.Lock()
+	madAPIResponseSessions.entries["oldest"] = oldest
+	madAPIResponseSessions.entries["newer"] = newer
+	madAPIResponseSessions.totalBytes = madAPIResponseSessionStateBytes(oldest) + madAPIResponseSessionStateBytes(newer)
+	madAPIResponseSessionTrim(now, 2, 100, 3)
+	_, oldestExists := madAPIResponseSessions.entries["oldest"]
+	_, newerExists := madAPIResponseSessions.entries["newer"]
+	madAPIResponseSessions.Unlock()
+
+	if oldestExists || !newerExists {
+		t.Fatal("item-limit eviction did not remove the least recently used entry")
+	}
+}
