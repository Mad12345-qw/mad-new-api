+
+func readCodexRequestBody(c *gin.Context) ([]byte, error) {
+	body, err := common.GetRequestBody(c)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = body.Seek(0, io.SeekStart); err != nil {
+		return nil, err
+	}
+	raw, err := io.ReadAll(body)
+	if _, seekErr := body.Seek(0, io.SeekStart); err == nil && seekErr != nil {
+		err = seekErr
+	}
+	return raw, err
+}
+
+func writeCodexCPANonStreamResponse(c *gin.Context, resp *http.Response, modelName string, originalRequest, convertedRequest []byte) error {
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 32<<20))
+	if err != nil {
+		return err
+	}
+	converted := relayconvert.ConvertCPAChatResponseToResponsesNonStream(c.Request.Context(), modelName, originalRequest, convertedRequest, body)
+	if !json.Valid(converted) {
+		return fmt.Errorf("CPA returned invalid non-stream JSON")
+	}
+	c.Header("Content-Type", "application/json")
+	c.Status(http.StatusOK)
+	_, err = c.Writer.Write(converted)
+	return err
+}
+
+func streamCodexCPAResponse(c *gin.Context, resp *http.Response, modelName string, originalRequest, convertedRequest []byte) error {
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("Cache-Control", "no-cache")
+	c.Header("Connection", "keep-alive")
+	c.Status(http.StatusOK)
+
+	scanner := bufio.NewScanner(resp.Body)
+	scanner.Buffer(make([]byte, 64<<10), 16<<20)
+	var state any
+	for scanner.Scan() {
+		line := bytes.TrimSpace(scanner.Bytes())
+		if len(line) == 0 || bytes.HasPrefix(line, []byte("event:")) {
+			continue
+		}
+		if !bytes.HasPrefix(line, []byte("data:")) {
+			continue
+		}
+		chunks := relayconvert.ConvertCPAChatResponseToResponsesStream(
+			c.Request.Context(), modelName, originalRequest, convertedRequest, append([]byte(nil), line...), &state,
+		)
+		for _, chunk := range chunks {
+			if _, err := c.Writer.Write(append(chunk, '\n', '\n')); err != nil {
+				return err
+			}
+			c.Writer.Flush()
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return err
 	}
+	return nil
 }
 
