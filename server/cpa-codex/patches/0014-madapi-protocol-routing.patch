+func TestMadAPINativeProtocolMappingOverridesChannelFallback(t *testing.T) {
+	cfg := &config.Config{}
+	tests := []struct {
+		wireProtocol string
+		channelType  int
+		provider     string
+	}{
+		{madAPIWireProtocolOpenAIResponses, 1, "codex"},
+		{madAPIWireProtocolAnthropicMessages, 1, "claude"},
+		{madAPIWireProtocolGeminiGenerate, 1, "gemini"},
+		{madAPIWireProtocolXAIResponses, 1, "xai"},
+		{madAPIWireProtocolOpenAIChat, madAPIChannelTypeKimi, "madapi-selected-channel"},
+		{"", madAPIChannelTypeKimi, "kimi"},
+	}
+	for _, test := range tests {
+		exec, provider := madAPINativeExecutorForProtocol(cfg, test.wireProtocol, test.channelType)
+		if exec == nil || provider != test.provider {
+			t.Fatalf("protocol %q channel %d => executor %T provider %q", test.wireProtocol, test.channelType, exec, provider)
+		}
+	}
+	if exec, provider := madAPINativeExecutorForProtocol(cfg, "unsupported", 1); exec != nil || provider != "" {
+		t.Fatalf("unsupported protocol => executor %T provider %q", exec, provider)
+	}
+}
