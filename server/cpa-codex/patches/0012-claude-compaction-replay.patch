+func decodeClaudeLocalCompaction(item gjson.Result) string {
+	if summary := strings.TrimSpace(item.Get("summary").String()); summary != "" {
+		return summary
+	}
+	encoded := strings.TrimSpace(item.Get("encrypted_content").String())
+	if !strings.HasPrefix(encoded, claudeLocalCompactionPrefix) {
+		return encoded
+	}
+	decoded, err := base64.RawURLEncoding.DecodeString(strings.TrimPrefix(encoded, claudeLocalCompactionPrefix))
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(decoded))
+}
