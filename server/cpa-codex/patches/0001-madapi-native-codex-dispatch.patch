+func TestConvertGeminiResponseToOpenAIResponses_MergesSplitFunctionCall(t *testing.T) {
+	in := []string{
+		`data: {"response":{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"shell_command","args":{}}}]}}],"modelVersion":"gemini-compatible","responseId":"split-function"}}`,
+		`data: {"response":{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"","args":{"command":"Get-ChildItem"}}}]}}],"modelVersion":"gemini-compatible","responseId":"split-function"}}`,
+		`data: {"response":{"candidates":[{"content":{"role":"model","parts":[{"text":""}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":10,"candidatesTokenCount":1,"totalTokenCount":11},"modelVersion":"gemini-compatible","responseId":"split-function"}}`,
+	}
+
+	var param any
+	var out [][]byte
+	for _, line := range in {
+		out = append(out, ConvertGeminiResponseToOpenAIResponses(context.Background(), "gemini-compatible", nil, nil, []byte(line), &param)...)
+	}
+
+	added := 0
+	done := 0
+	completedCalls := 0
+	for _, chunk := range out {
+		event, data := parseSSEEvent(t, chunk)
+		switch event {
+		case "response.output_item.added":
+			if data.Get("item.type").String() == "function_call" {
+				added++
+				if data.Get("item.name").String() != "shell_command" {
+					t.Fatalf("added function name = %q", data.Get("item.name").String())
+				}
+			}
+		case "response.output_item.done":
+			if data.Get("item.type").String() == "function_call" {
+				done++
+				if data.Get("item.name").String() != "shell_command" || gjson.Get(data.Get("item.arguments").String(), "command").String() != "Get-ChildItem" {
+					t.Fatalf("invalid merged function item: %s", data.Get("item").Raw)
+				}
+			}
+		case "response.completed":
+			for _, item := range data.Get("response.output").Array() {
+				if item.Get("type").String() != "function_call" {
+					continue
+				}
+				completedCalls++
+				if item.Get("name").String() != "shell_command" || gjson.Get(item.Get("arguments").String(), "command").String() != "Get-ChildItem" {
+					t.Fatalf("invalid completed function item: %s", item.Raw)
+				}
+			}
+		}
+	}
+
+	if added != 1 || done != 1 || completedCalls != 1 {
+		t.Fatalf("split function emitted duplicates: added=%d done=%d completed=%d", added, done, completedCalls)
+	}
+}
