+func ensureTaskRecordBeforeUpstream(platform constant.TaskPlatform, info *relaycommon.RelayInfo) error {
+	task, exists, err := model.GetByTaskId(info.UserId, info.PublicTaskID)
+	if err != nil {
+		return err
+	}
+	if exists {
