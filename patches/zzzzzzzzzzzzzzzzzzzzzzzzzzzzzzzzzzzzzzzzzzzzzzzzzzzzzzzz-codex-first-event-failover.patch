+func TestMadAPICodexFirstEventDeadlineOnlyAppliesToMeasuredGPTModels(t *testing.T) {
+	for _, model := range []string{"gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna"} {
+		if timeout := madAPICodexFirstEventTimeoutForModel(model); timeout != 30*time.Second {
+			t.Fatalf("model %s timeout = %s, want 30 seconds", model, timeout)
+		}
+	}
+	if timeout := madAPICodexFirstEventTimeoutForModel("deepseek-v4-pro"); timeout != 0 {
+		t.Fatal("slow-thinking DeepSeek model must keep the existing dispatch timeout")
+	}
+	client := madAPICPADispatchClientForFirstEvent("gpt-5.6-sol")
+	transport, ok := client.Transport.(*http.Transport)
+	if !ok || transport.ResponseHeaderTimeout != 30*time.Second {
+		t.Fatalf("first-event transport timeout = %#v, want 30 seconds", client.Transport)
+	}
+	if madAPICPADispatchClientForFirstEvent("deepseek-v4-pro") != madAPICPADispatchClient {
+		t.Fatal("unmeasured model must keep the existing dispatch client")
+	}
+}
