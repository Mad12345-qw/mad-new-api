+func TestMadAPICPAContractRetryClassification(t *testing.T) {
+	for _, statusCode := range []int{http.StatusBadRequest, http.StatusConflict, http.StatusUnprocessableEntity} {
+		t.Run(http.StatusText(statusCode), func(t *testing.T) {
+			newAPIError := types.NewErrorWithStatusCode(errors.New("deterministic"), types.ErrorCodeBadResponseStatusCode, statusCode)
+			if !types.IsSkipRetryError(markMadAPICPAContractError(statusCode, newAPIError)) {
+				t.Fatalf("CPA contract status %d must not be retried", statusCode)
+			}
+		})
+	}
+
+	retryable := types.NewErrorWithStatusCode(errors.New("startup failure"), types.ErrorCodeBadResponseStatusCode, http.StatusBadGateway)
+	if types.IsSkipRetryError(markMadAPICPAContractError(http.StatusBadGateway, retryable)) {
+		t.Fatal("CPA startup 502 must remain retryable before stream commitment")
+	}
+}
