+func TestIsMadAPICodexInternalRequestRequiresLoopbackAndDispatchToken(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv(constant.MadAPICodexDispatchTokenEnv, "dispatch-secret")
+	request := httptest.NewRequest(http.MethodPost, "/v1/responses/compact", nil)
+	request.RemoteAddr = "127.0.0.1:42000"
+	request.Header.Set(constant.MadAPICodexDispatchHeader, "dispatch-secret")
+	context, _ := gin.CreateTestContext(httptest.NewRecorder())
+	context.Request = request
+	if !isMadAPICodexInternalRequest(context) {
+		t.Fatal("loopback request with dispatch token must keep the base compact model")
+	}
+	request.RemoteAddr = "198.51.100.20:42000"
+	if isMadAPICodexInternalRequest(context) {
+		t.Fatal("public request must not bypass compact model routing")
+	}
