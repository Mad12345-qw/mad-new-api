+func TestRestoreResponsesToolOutputsRestoresNamespaceAndCustomTools(t *testing.T) {
+	req := &dto.OpenAIResponsesRequest{
+		Tools: mustResponsesRawMessage(t, []map[string]any{
+			{
+				"type":  "namespace",
+				"name":  "mcp__github",
+				"tools": []map[string]any{{"type": "function", "name": "get_me"}},
+			},
+		}),
+		Input: mustResponsesRawMessage(t, []map[string]any{
+			{
+				"type": "additional_tools",
+				"tools": []map[string]any{
+					{
+						"type":  "namespace",
+						"name":  "terminal",
+						"tools": []map[string]any{{"type": "custom", "name": "exec"}},
+					},
+				},
+			},
+		}),
+	}
+	resp := &dto.OpenAIResponsesResponse{Output: []dto.ResponsesOutput{
+		{Type: "function_call", Name: "mcp__github__get_me", Arguments: []byte(`"{}"`)},
+		{Type: "function_call", Name: "terminal__exec", Arguments: []byte(`"{\"input\":\"pwd\"}"`)},
+	}}
+
+	RestoreResponsesToolOutputs(resp, req)
+	require.Len(t, resp.Output, 2)
+	assert.Equal(t, "get_me", resp.Output[0].Name)
+	assert.Equal(t, "mcp__github", resp.Output[0].Namespace)
+	assert.Equal(t, "custom_tool_call", resp.Output[1].Type)
+	assert.Equal(t, "terminal__exec", resp.Output[1].Name)
+	assert.JSONEq(t, `"pwd"`, string(resp.Output[1].Input))
+	assert.Empty(t, resp.Output[1].Arguments)
+}
+
+func TestChatToResponsesStreamRestoresNamespaceToolCall(t *testing.T) {
+	req := &dto.OpenAIResponsesRequest{Tools: mustResponsesRawMessage(t, []map[string]any{
+		{
+			"type":  "namespace",
+			"name":  "mcp__github",
+			"tools": []map[string]any{{"type": "function", "name": "get_me"}},
+		},
+	})}
+	state := NewChatToResponsesStreamState("resp_1", "deepseek-v4-flash")
+	state.SetOriginalResponsesRequest(req)
+	toolIndex := 0
+	chunk := &dto.ChatCompletionsStreamResponse{Choices: []dto.ChatCompletionsStreamResponseChoice{
+		{Delta: dto.ChatCompletionsStreamResponseChoiceDelta{ToolCalls: []dto.ToolCallResponse{
+			{Index: &toolIndex, ID: "call_1", Type: "function", Function: dto.FunctionResponse{Name: "mcp__github__get_me", Arguments: `{}`}},
+		}}},
+	}}
+
+	events, err := ChatCompletionsStreamChunkToResponsesEvents(chunk, state)
+	require.NoError(t, err)
+	var added *dto.ResponsesOutput
+	for _, event := range events {
+		if event.Type == responsesEventOutputItemAdded {
+			added = event.Payload.Item
+		}
+	}
+	require.NotNil(t, added)
+	assert.Equal(t, "get_me", added.Name)
+	assert.Equal(t, "mcp__github", added.Namespace)
+
+	finalEvents := FinalizeChatCompletionsStreamToResponses(state)
+	require.NotEmpty(t, finalEvents)
+	completed := finalEvents[len(finalEvents)-1].Payload.Response
+	require.NotNil(t, completed)
+	require.Len(t, completed.Output, 1)
+	assert.Equal(t, "get_me", completed.Output[0].Name)
+	assert.Equal(t, "mcp__github", completed.Output[0].Namespace)
+}
+
+func mustResponsesRawMessage(t *testing.T, value any) json.RawMessage {
+	t.Helper()
+	raw, err := json.Marshal(value)
+	require.NoError(t, err)
+	return raw
+}
