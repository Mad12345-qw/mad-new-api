diff --git a/internal/api/madapi_native_codex.go b/internal/api/madapi_native_codex.go
new file mode 100644
index 00000000..cb3bf0da
--- /dev/null
+++ b/internal/api/madapi_native_codex.go
@@ -0,0 +1,264 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+const (
+	madAPICodexDispatchTokenEnv = "MADAPI_CODEX_DISPATCH_TOKEN"
+	madAPICodexDispatchHeader   = "X-MadAPI-Codex-Dispatch-Token"
+	madAPICodexDispatchMaxBody  = 64 << 20
+)
+
+const (
+	madAPIChannelTypeClaude = 14
+	madAPIChannelTypeGemini = 24
+	madAPIChannelTypeKimi   = 25
+	madAPIChannelTypeXAI    = 48
+	madAPIChannelTypeCodex  = 57
+)
+
+type madAPINativeCodexRequest struct {
+	ChannelType int               `json:"channel_type"`
+	ChannelID   int               `json:"channel_id"`
+	BaseURL     string            `json:"base_url"`
+	APIKey      string            `json:"api_key"`
+	Model       string            `json:"model"`
+	Headers     map[string]string `json:"headers,omitempty"`
+	Body        json.RawMessage   `json:"body"`
+	Stream      bool              `json:"stream"`
+	Compact     bool              `json:"compact"`
+	RequestPath string            `json:"request_path,omitempty"`
+}
+
+type madAPINativeExecutor interface {
+	Execute(context.Context, *cliproxyauth.Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (cliproxyexecutor.Response, error)
+	ExecuteStream(context.Context, *cliproxyauth.Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error)
+}
+
+type madAPINativeExecutorFactory func(*config.Config, int) (madAPINativeExecutor, string)
+
+func (s *Server) madAPINativeCodexExecute(c *gin.Context) {
+	s.madAPINativeCodexExecuteWithFactory(c, madAPINativeExecutorForChannel)
+}
+
+func (s *Server) madAPINativeCodexExecuteWithFactory(c *gin.Context, factory madAPINativeExecutorFactory) {
+	if !madAPICodexDispatchAuthorized(c.Request) {
+		c.Status(http.StatusNotFound)
+		return
+	}
+
+	decoder := json.NewDecoder(io.LimitReader(c.Request.Body, madAPICodexDispatchMaxBody+1))
+	var dispatch madAPINativeCodexRequest
+	if err := decoder.Decode(&dispatch); err != nil {
+		writeMadAPINativeError(c, http.StatusBadRequest, fmt.Errorf("invalid dispatch request: %w", err))
+		return
+	}
+	if strings.TrimSpace(dispatch.Model) == "" || len(dispatch.Body) == 0 || !json.Valid(dispatch.Body) {
+		writeMadAPINativeError(c, http.StatusBadRequest, errors.New("dispatch model and JSON body are required"))
+		return
+	}
+
+	nativeExecutor, provider := factory(s.cfg, dispatch.ChannelType)
+	if nativeExecutor == nil {
+		writeMadAPINativeError(c, http.StatusBadRequest, fmt.Errorf("no CPA executor for channel type %d", dispatch.ChannelType))
+		return
+	}
+	auth := madAPINativeAuth(dispatch, provider)
+	headers := make(http.Header, len(dispatch.Headers))
+	for name, value := range dispatch.Headers {
+		if strings.TrimSpace(name) != "" && strings.TrimSpace(value) != "" {
+			headers.Set(name, value)
+		}
+	}
+
+	metadata := map[string]any{
+		cliproxyexecutor.RequestedModelMetadataKey: dispatch.Model,
+		cliproxyexecutor.RequestPathMetadataKey:   dispatch.RequestPath,
+	}
+	req := cliproxyexecutor.Request{
+		Model:    dispatch.Model,
+		Payload:  bytes.Clone(dispatch.Body),
+		Format:   sdktranslator.FormatOpenAIResponse,
+		Metadata: metadata,
+	}
+	opts := cliproxyexecutor.Options{
+		Stream:          dispatch.Stream,
+		Headers:         headers,
+		OriginalRequest: bytes.Clone(dispatch.Body),
+		SourceFormat:    sdktranslator.FormatOpenAIResponse,
+		ResponseFormat:  sdktranslator.FormatOpenAIResponse,
+		Metadata:        metadata,
+	}
+	if dispatch.Compact {
+		opts.Alt = "responses/compact"
+	}
+
+	if dispatch.Stream {
+		result, err := nativeExecutor.ExecuteStream(c.Request.Context(), auth, req, opts)
+		if err != nil {
+			writeMadAPINativeError(c, madAPIExecutorStatus(err), err)
+			return
+		}
+		writeMadAPINativeStream(c, result)
+		return
+	}
+
+	result, err := nativeExecutor.Execute(c.Request.Context(), auth, req, opts)
+	if err != nil {
+		writeMadAPINativeError(c, madAPIExecutorStatus(err), err)
+		return
+	}
+	copyMadAPIUpstreamHeaders(c.Writer.Header(), result.Headers)
+	c.Data(http.StatusOK, "application/json", result.Payload)
+}
+
+func madAPINativeExecutorForChannel(cfg *config.Config, channelType int) (madAPINativeExecutor, string) {
+	switch channelType {
+	case madAPIChannelTypeXAI:
+		return executor.NewXAIAutoExecutor(cfg), "xai"
+	case madAPIChannelTypeClaude:
+		return executor.NewClaudeExecutor(cfg), "claude"
+	case madAPIChannelTypeGemini:
+		return executor.NewGeminiExecutor(cfg), "gemini"
+	case madAPIChannelTypeKimi:
+		return executor.NewKimiExecutor(cfg), "kimi"
+	case madAPIChannelTypeCodex:
+		return executor.NewCodexAutoExecutor(cfg), "codex"
+	default:
+		return executor.NewOpenAICompatExecutor("madapi-selected-channel", cfg), "madapi-selected-channel"
+	}
+}
+
+func madAPINativeAuth(dispatch madAPINativeCodexRequest, provider string) *cliproxyauth.Auth {
+	attributes := map[string]string{
+		"api_key":  dispatch.APIKey,
+		"base_url": madAPINativeBaseURL(dispatch.BaseURL, provider),
+		"auth_kind": "api",
+	}
+	if provider == "xai" {
+		attributes["using_api"] = "true"
+	}
+	for name, value := range dispatch.Headers {
+		name = strings.TrimSpace(name)
+		value = strings.TrimSpace(value)
+		if name != "" && value != "" {
+			attributes["header:"+name] = value
+		}
+	}
+	return &cliproxyauth.Auth{
+		ID:         "madapi-channel-" + strconv.Itoa(dispatch.ChannelID),
+		Provider:   provider,
+		Attributes: attributes,
+	}
+}
+
+func madAPINativeBaseURL(rawBaseURL, provider string) string {
+	baseURL := strings.TrimRight(strings.TrimSpace(rawBaseURL), "/")
+	switch provider {
+	case "xai", "madapi-selected-channel":
+		if baseURL != "" && !strings.HasSuffix(strings.ToLower(baseURL), "/v1") {
+			baseURL += "/v1"
+		}
+	}
+	return baseURL
+}
+
+func madAPICodexDispatchAuthorized(request *http.Request) bool {
+	if request == nil || !madAPIInternalRemote(request.RemoteAddr) {
+		return false
+	}
+	expected := strings.TrimSpace(os.Getenv(madAPICodexDispatchTokenEnv))
+	provided := strings.TrimSpace(request.Header.Get(madAPICodexDispatchHeader))
+	return expected != "" && len(expected) == len(provided) && subtle.ConstantTimeCompare([]byte(expected), []byte(provided)) == 1
+}
+
+func madAPIInternalRemote(remoteAddr string) bool {
+	host, _, err := net.SplitHostPort(strings.TrimSpace(remoteAddr))
+	if err != nil {
+		host = strings.Trim(strings.TrimSpace(remoteAddr), "[]")
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && (ip.IsLoopback() || ip.IsPrivate())
+}
+
+func madAPIExecutorStatus(err error) int {
+	var statusErr interface{ StatusCode() int }
+	if errors.As(err, &statusErr) {
+		if status := statusErr.StatusCode(); status >= 400 && status <= 599 {
+			return status
+		}
+	}
+	return http.StatusBadGateway
+}
+
+func writeMadAPINativeError(c *gin.Context, status int, err error) {
+	if status < 400 || status > 599 {
+		status = http.StatusBadGateway
+	}
+	body := []byte(strings.TrimSpace(err.Error()))
+	if json.Valid(body) {
+		c.Data(status, "application/json", body)
+		return
+	}
+	c.JSON(status, gin.H{"error": gin.H{"type": "cpa_native_dispatch_error", "message": err.Error()}})
+}
+
+func writeMadAPINativeStream(c *gin.Context, result *cliproxyexecutor.StreamResult) {
+	if result == nil || result.Chunks == nil {
+		writeMadAPINativeError(c, http.StatusBadGateway, errors.New("CPA executor returned an empty stream"))
+		return
+	}
+	copyMadAPIUpstreamHeaders(c.Writer.Header(), result.Headers)
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("Cache-Control", "no-cache")
+	c.Header("Connection", "keep-alive")
+	c.Status(http.StatusOK)
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			payload, _ := json.Marshal(gin.H{"type": "error", "error": gin.H{"type": "upstream_error", "message": chunk.Err.Error()}})
+			_, _ = fmt.Fprintf(c.Writer, "event: error\ndata: %s\n\n", payload)
+			c.Writer.Flush()
+			return
+		}
+		if len(chunk.Payload) == 0 {
+			continue
+		}
+		_, _ = c.Writer.Write(chunk.Payload)
+		if !bytes.HasSuffix(chunk.Payload, []byte("\n")) {
+			_, _ = c.Writer.Write([]byte("\n"))
+		}
+		_, _ = c.Writer.Write([]byte("\n"))
+		c.Writer.Flush()
+	}
+}
+
+func copyMadAPIUpstreamHeaders(dst, src http.Header) {
+	for name, values := range src {
+		switch strings.ToLower(name) {
+		case "connection", "content-length", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade":
+			continue
+		}
+		for _, value := range values {
+			dst.Add(name, value)
+		}
+	}
+}
diff --git a/internal/api/madapi_native_codex_test.go b/internal/api/madapi_native_codex_test.go
new file mode 100644
index 00000000..5eafc2fa
--- /dev/null
+++ b/internal/api/madapi_native_codex_test.go
@@ -0,0 +1,138 @@
+package api
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+type madAPICaptureExecutor struct {
+	auth *cliproxyauth.Auth
+	req  cliproxyexecutor.Request
+	opts cliproxyexecutor.Options
+}
+
+func (e *madAPICaptureExecutor) Execute(_ context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	e.auth = auth
+	e.req = req
+	e.opts = opts
+	return cliproxyexecutor.Response{
+		Payload: []byte(`{"id":"resp-1","object":"response","status":"completed"}`),
+		Headers: http.Header{"X-Upstream-Test": {"native"}},
+	}, nil
+}
+
+func (*madAPICaptureExecutor) ExecuteStream(context.Context, *cliproxyauth.Auth, cliproxyexecutor.Request, cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	return nil, nil
+}
+
+func TestMadAPINativeCodexExecuteUsesSelectedChannel(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv(madAPICodexDispatchTokenEnv, "dispatch-secret")
+	capture := &madAPICaptureExecutor{}
+	server := &Server{cfg: &config.Config{}}
+	router := gin.New()
+	router.POST("/internal/madapi/codex/execute", func(c *gin.Context) {
+		server.madAPINativeCodexExecuteWithFactory(c, func(_ *config.Config, channelType int) (madAPINativeExecutor, string) {
+			if channelType != madAPIChannelTypeXAI {
+				t.Fatalf("channel type = %d, want xAI", channelType)
+			}
+			return capture, "xai"
+		})
+	})
+
+	body := `{"channel_type":48,"channel_id":17,"base_url":"https://api.x.ai/v1/","api_key":"provider-secret","model":"grok-4.5","headers":{"X-Test":"yes"},"body":{"model":"grok-4.5","input":"hi"},"stream":false,"request_path":"/v1/responses"}`
+	req := httptest.NewRequest(http.MethodPost, "/internal/madapi/codex/execute", strings.NewReader(body))
+	req.RemoteAddr = "127.0.0.1:41000"
+	req.Header.Set(madAPICodexDispatchHeader, "dispatch-secret")
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, req)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, body = %s", recorder.Code, recorder.Body.String())
+	}
+	if got := recorder.Header().Get("X-Upstream-Test"); got != "native" {
+		t.Fatalf("upstream header = %q", got)
+	}
+	if capture.auth == nil || capture.auth.Provider != "xai" {
+		t.Fatalf("auth = %#v", capture.auth)
+	}
+	if got := capture.auth.Attributes["api_key"]; got != "provider-secret" {
+		t.Fatalf("api key = %q", got)
+	}
+	if got := capture.auth.Attributes["base_url"]; got != "https://api.x.ai/v1" {
+		t.Fatalf("base URL = %q", got)
+	}
+	if got := capture.auth.Attributes["using_api"]; got != "true" {
+		t.Fatalf("using_api = %q", got)
+	}
+	if capture.req.Model != "grok-4.5" || capture.opts.SourceFormat != sdktranslator.FormatOpenAIResponse || capture.opts.ResponseFormat != sdktranslator.FormatOpenAIResponse {
+		t.Fatalf("request/options not preserved: %#v %#v", capture.req, capture.opts)
+	}
+}
+
+func TestMadAPICodexDispatchAuthorization(t *testing.T) {
+	t.Setenv(madAPICodexDispatchTokenEnv, "dispatch-secret")
+	request := httptest.NewRequest(http.MethodPost, "http://internal.test", nil)
+	request.RemoteAddr = "198.51.100.10:1234"
+	request.Header.Set(madAPICodexDispatchHeader, "dispatch-secret")
+	if madAPICodexDispatchAuthorized(request) {
+		t.Fatal("public source must be rejected")
+	}
+	request.RemoteAddr = "172.20.0.4:1234"
+	if !madAPICodexDispatchAuthorized(request) {
+		t.Fatal("private source with matching token must be accepted")
+	}
+	request.Header.Set(madAPICodexDispatchHeader, "wrong")
+	if madAPICodexDispatchAuthorized(request) {
+		t.Fatal("wrong token must be rejected")
+	}
+}
+
+func TestMadAPINativeExecutorMapping(t *testing.T) {
+	cfg := &config.Config{}
+	tests := []struct {
+		channelType int
+		provider    string
+	}{
+		{madAPIChannelTypeXAI, "xai"},
+		{madAPIChannelTypeClaude, "claude"},
+		{madAPIChannelTypeGemini, "gemini"},
+		{madAPIChannelTypeKimi, "kimi"},
+		{madAPIChannelTypeCodex, "codex"},
+		{1, "madapi-selected-channel"},
+	}
+	for _, test := range tests {
+		exec, provider := madAPINativeExecutorForChannel(cfg, test.channelType)
+		if exec == nil || provider != test.provider {
+			t.Fatalf("channel %d => executor %T provider %q", test.channelType, exec, provider)
+		}
+	}
+}
+
+func TestMadAPINativeBaseURLMatchesCPAExecutorContract(t *testing.T) {
+	tests := []struct {
+		baseURL  string
+		provider string
+		want     string
+	}{
+		{"https://api.x.ai", "xai", "https://api.x.ai/v1"},
+		{"https://api.x.ai/v1/", "xai", "https://api.x.ai/v1"},
+		{"https://proxy.example/openai", "madapi-selected-channel", "https://proxy.example/openai/v1"},
+		{"https://api.anthropic.com/", "claude", "https://api.anthropic.com"},
+		{"https://generativelanguage.googleapis.com/", "gemini", "https://generativelanguage.googleapis.com"},
+	}
+	for _, test := range tests {
+		if got := madAPINativeBaseURL(test.baseURL, test.provider); got != test.want {
+			t.Fatalf("base URL %q provider %q => %q, want %q", test.baseURL, test.provider, got, test.want)
+		}
+	}
+}
