+func buildCodexCockpitNativeCatalog(c *gin.Context, models []dto.OpenAIModels) ([]byte, error) {
+	available := make([]map[string]any, 0, len(models))
+	for _, candidate := range models {
+		available = append(available, codexAvailableModel(candidate))
+	}
+	body, err := common.Marshal(gin.H{"models": available})
+	if err != nil {
+		return nil, fmt.Errorf("encode CPA model catalog request: %w", err)
+	}
+
+	dispatchURL := strings.TrimSpace(os.Getenv(appconstant.MadAPICPADispatchURLEnv))
+	if dispatchURL == "" {
+		dispatchURL = defaultCodexCPADispatchURL
+	}
+	if !strings.HasSuffix(dispatchURL, "/execute") {
+		return nil, fmt.Errorf("CPA dispatch URL must end with /execute")
+	}
+	modelsURL := strings.TrimSuffix(dispatchURL, "/execute") + "/models"
+	req, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, modelsURL, bytes.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("create CPA model catalog request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set(appconstant.MadAPICodexDispatchHeader, strings.TrimSpace(os.Getenv(appconstant.MadAPICodexDispatchTokenEnv)))
+	resp, err := codexInternalHTTPClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("CPA model catalog request failed: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("CPA model catalog request returned HTTP %d", resp.StatusCode)
+	}
+	catalog, err := io.ReadAll(io.LimitReader(resp.Body, 64<<20))
+	if err != nil {
+		return nil, fmt.Errorf("read CPA model catalog: %w", err)
+	}
+	var decoded codexModelsResponse
+	if err = json.Unmarshal(catalog, &decoded); err != nil {
+		return nil, fmt.Errorf("decode CPA model catalog: %w", err)
+	}
+	if len(decoded.Models) != len(models) {
+		return nil, fmt.Errorf("CPA model catalog count mismatch: got %d, want %d", len(decoded.Models), len(models))
+	}
+	return catalog, nil
 }
 
