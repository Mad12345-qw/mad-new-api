+func TestConvertClaudeResponseToOpenAIResponses_PreservesCustomToolCall(t *testing.T) {
+	originalRequest := []byte(`{"model":"gpt-test","tools":[{"type":"custom","name":"run_shell","format":{"type":"text"}}]}`)
+	chunks := [][]byte{
+		[]byte(`data: {"type":"message_start","message":{"id":"msg_custom","usage":{"input_tokens":1,"output_tokens":0}}}`),
+		[]byte(`data: {"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"call_custom","name":"run_shell","input":{}}}`),
+		[]byte(`data: {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\"input\":\"printf CPA_CUSTOM_OK\"}"}}`),
+		[]byte(`data: {"type":"content_block_stop","index":0}`),
+		[]byte(`data: {"type":"message_stop"}`),
+	}
+
+	var param any
+	var added, inputDone, itemDone, completed gjson.Result
+	functionArgumentEvents := 0
+	for _, chunk := range chunks {
+		for _, output := range ConvertClaudeResponseToOpenAIResponses(context.Background(), "claude-test", originalRequest, nil, chunk, &param) {
+			event, data := parseClaudeResponsesSSEEvent(t, output)
+			switch event {
+			case "response.output_item.added":
+				added = data
+			case "response.custom_tool_call_input.done":
+				inputDone = data
+			case "response.output_item.done":
+				itemDone = data
+			case "response.completed":
+				completed = data
+			case "response.function_call_arguments.delta", "response.function_call_arguments.done":
+				functionArgumentEvents++
+			}
+		}
+	}
+
+	if got := added.Get("item.type").String(); got != "custom_tool_call" {
+		t.Fatalf("added item type = %q, want custom_tool_call", got)
+	}
+	if got := inputDone.Get("input").String(); got != "printf CPA_CUSTOM_OK" {
+		t.Fatalf("custom tool input = %q", got)
+	}
+	if got := itemDone.Get("item.type").String(); got != "custom_tool_call" {
+		t.Fatalf("done item type = %q, want custom_tool_call", got)
+	}
+	if got := completed.Get("response.output.0.type").String(); got != "custom_tool_call" {
+		t.Fatalf("completed output type = %q, want custom_tool_call", got)
+	}
+	if got := completed.Get("response.output.0.input").String(); got != "printf CPA_CUSTOM_OK" {
+		t.Fatalf("completed custom tool input = %q", got)
+	}
+	if functionArgumentEvents != 0 {
+		t.Fatalf("function argument events = %d, want 0", functionArgumentEvents)
+	}
+}
+
