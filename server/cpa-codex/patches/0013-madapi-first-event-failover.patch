+func TestMadAPICodexFirstEventRequiresSemanticPayload(t *testing.T) {
+	created := []cliproxyexecutor.StreamChunk{{Payload: []byte("event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp-1\"}}\n\n")}}
+	if madAPICodexStreamHasFirstEvent(created) {
+		t.Fatal("response.created must not commit the client stream")
+	}
+
+	text := append(created, cliproxyexecutor.StreamChunk{Payload: []byte("event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\n")})
+	if !madAPICodexStreamHasFirstEvent(text) {
+		t.Fatal("non-empty output text must commit the client stream")
+	}
+
+	tool := []cliproxyexecutor.StreamChunk{{Payload: []byte("event: response.function_call_arguments.done\ndata: {\"type\":\"response.function_call_arguments.done\",\"arguments\":\"{}\"}\n\n")}}
+	if !madAPICodexStreamHasFirstEvent(tool) {
+		t.Fatal("completed function-call arguments must commit the client stream")
+	}
+
+	outputItemDone := []cliproxyexecutor.StreamChunk{{Payload: []byte("event: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"custom_tool_call\",\"call_id\":\"call-1\"}}\n\n")}}
+	if !madAPICodexStreamHasFirstEvent(outputItemDone) {
+		t.Fatal("completed custom tool call must commit the client stream")
+	}
+}
+
+func TestMadAPIFirstEventFailureStatusNormalizesGatewayFailures(t *testing.T) {
+	if got := madAPIFirstEventFailureStatus(&madAPIFirstEventError{status: http.StatusGatewayTimeout, err: context.DeadlineExceeded}); got != http.StatusBadGateway {
+		t.Fatalf("504 before stream commit = %d, want retryable 502", got)
+	}
+	if got := madAPIFirstEventFailureStatus(&madAPIFirstEventError{status: http.StatusBadRequest, err: errors.New("bad request")}); got != http.StatusBadRequest {
+		t.Fatalf("400 before stream commit = %d, want 400", got)
+	}
+}
+
+func TestMadAPICodexFirstEventFailureKeepsResponseUncommitted(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+	chunks <- cliproxyexecutor.StreamChunk{Err: &madAPIFirstEventError{status: http.StatusBadGateway, err: context.DeadlineExceeded}}
+	close(chunks)
+
+	err := writeMadAPINativeStream(c, &cliproxyexecutor.StreamResult{Chunks: chunks}, time.Second)
+	if err == nil {
+		t.Fatal("expected first-event failure")
+	}
+	if recorder.Code != http.StatusOK || recorder.Body.Len() != 0 {
+		t.Fatalf("first-event failure wrote a client response: status=%d body=%q", recorder.Code, recorder.Body.String())
+	}
+	var statusErr interface{ StatusCode() int }
+	if !errors.As(err, &statusErr) || statusErr.StatusCode() != http.StatusBadGateway {
+		t.Fatalf("error = %v, want retryable 502", err)
+	}
+}
+
+func TestMadAPICodexFirstEventCommitsThenDoesNotReplay(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("event: response.created\ndata: {\"type\":\"response.created\"}\n\n")}
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\n")}
+	close(chunks)
+
+	if err := writeMadAPINativeStream(c, &cliproxyexecutor.StreamResult{Chunks: chunks}, time.Second); err != nil {
+		t.Fatal(err)
+	}
+	body := recorder.Body.String()
+	if strings.Count(body, "response.created") != 2 || strings.Count(body, "response.output_text.delta") != 2 {
+		t.Fatalf("buffered startup frames were not written exactly once: %q", body)
+	}
