+	originalRequest := []byte(`{"model":"gpt-test","tools":[{"type":"custom","name":"run_shell","format":{"type":"text"}}]}`)
+	raw := []byte(strings.Join([]string{
+		`data: {"type":"message_start","message":{"id":"msg_custom","usage":{"input_tokens":1,"output_tokens":0}}}`,
+		`data: {"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"call_custom","name":"run_shell","input":{}}}`,
+		`data: {"type":"content_block_delta","index":0,"delta":{"type":"input_json_delta","partial_json":"{\"input\":\"printf CPA_CUSTOM_OK\"}"}}`,
+		`data: {"type":"content_block_stop","index":0}`,
+		`data: {"type":"message_stop"}`,
+	}, "\n"))
+
+	out := ConvertClaudeResponseToOpenAIResponsesNonStream(context.Background(), "claude-test", originalRequest, nil, raw, nil)
+	root := gjson.ParseBytes(out)
+	if got := root.Get("output.0.type").String(); got != "custom_tool_call" {
+		t.Fatalf("non-stream output type = %q, want custom_tool_call; response=%s", got, out)
+	}
+	if got := root.Get("output.0.input").String(); got != "printf CPA_CUSTOM_OK" {
+		t.Fatalf("non-stream custom tool input = %q", got)
+	}
+}
