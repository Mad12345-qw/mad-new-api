diff --git a/relay/cpa_native_codex.go b/relay/cpa_native_codex.go
new file mode 100644
index 00000000..6370d7c5
--- /dev/null
+++ b/relay/cpa_native_codex.go
@@ -0,0 +1,182 @@
+package relay
+
+import (
+	"bytes"
+	"crypto/subtle"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	appconstant "github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/relay/channel"
+	"github.com/QuantumNous/new-api/relay/channel/openai"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relay/helper"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+	"github.com/tidwall/sjson"
+)
+
+const defaultMadAPICPADispatchURL = "http://cpa-codex:8317/internal/madapi/codex/execute"
+
+var madAPICPADispatchClient = &http.Client{
+	Transport: &http.Transport{
+		Proxy:                 http.ProxyFromEnvironment,
+		DialContext:           (&net.Dialer{Timeout: 5 * time.Second, KeepAlive: 30 * time.Second}).DialContext,
+		ForceAttemptHTTP2:     false,
+		MaxIdleConns:          64,
+		MaxIdleConnsPerHost:   64,
+		IdleConnTimeout:       90 * time.Second,
+		ResponseHeaderTimeout: 360 * time.Second,
+	},
+}
+
+type madAPICodexDispatchRequest struct {
+	ChannelType  int               `json:"channel_type"`
+	ChannelID    int               `json:"channel_id"`
+	BaseURL      string            `json:"base_url"`
+	APIKey       string            `json:"api_key"`
+	Model        string            `json:"model"`
+	Headers      map[string]string `json:"headers,omitempty"`
+	Body         json.RawMessage   `json:"body"`
+	Stream       bool              `json:"stream"`
+	Compact      bool              `json:"compact"`
+	RequestPath  string            `json:"request_path,omitempty"`
+	SessionScope string            `json:"session_scope,omitempty"`
+}
+
+func isMadAPICodexNativeRequest(c *gin.Context) bool {
+	if c == nil || c.Request == nil || !madAPILoopbackRemote(c.Request.RemoteAddr) {
+		return false
+	}
+	expected := strings.TrimSpace(os.Getenv(appconstant.MadAPICodexDispatchTokenEnv))
+	provided := strings.TrimSpace(c.GetHeader(appconstant.MadAPICodexDispatchHeader))
+	return expected != "" && len(expected) == len(provided) && subtle.ConstantTimeCompare([]byte(expected), []byte(provided)) == 1
+}
+
+func madAPILoopbackRemote(remoteAddr string) bool {
+	host, _, err := net.SplitHostPort(strings.TrimSpace(remoteAddr))
+	if err != nil {
+		host = strings.Trim(strings.TrimSpace(remoteAddr), "[]")
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
+
+func relayMadAPICodexNative(c *gin.Context, info *relaycommon.RelayInfo) *types.NewAPIError {
+	payload, err := madAPICodexDispatchPayload(c, info)
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeConvertRequestFailed, types.ErrOptionWithSkipRetry())
+	}
+	requestBody, err := common.Marshal(payload)
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeConvertRequestFailed, types.ErrOptionWithSkipRetry())
+	}
+
+	dispatchURL := strings.TrimSpace(os.Getenv(appconstant.MadAPICPADispatchURLEnv))
+	if dispatchURL == "" {
+		dispatchURL = defaultMadAPICPADispatchURL
+	}
+	req, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, dispatchURL, bytes.NewReader(requestBody))
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeDoRequestFailed)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set(appconstant.MadAPICodexDispatchHeader, strings.TrimSpace(os.Getenv(appconstant.MadAPICodexDispatchTokenEnv)))
+
+	resp, err := madAPICPADispatchClient.Do(req)
+	if err != nil {
+		return types.NewErrorWithStatusCode(fmt.Errorf("CPA native dispatch failed: %w", err), types.ErrorCodeDoRequestFailed, http.StatusBadGateway)
+	}
+	if resp.StatusCode != http.StatusOK {
+		newAPIError := service.RelayErrorHandler(c.Request.Context(), resp, false)
+		service.ResetStatusCode(newAPIError, c.GetString("status_code_mapping"))
+		return newAPIError
+	}
+
+	var usage *dto.Usage
+	var newAPIError *types.NewAPIError
+	if info.RelayMode == relayconstant.RelayModeResponsesCompact {
+		usage, newAPIError = openai.OaiResponsesCompactionHandler(c, resp)
+	} else if info.IsStream {
+		usage, newAPIError = openai.OaiResponsesStreamHandler(c, info, resp)
+	} else {
+		usage, newAPIError = openai.OaiResponsesHandler(c, info, resp)
+	}
+	if newAPIError != nil {
+		service.ResetStatusCode(newAPIError, c.GetString("status_code_mapping"))
+		return newAPIError
+	}
+	if usage == nil {
+		usage = &dto.Usage{}
+	}
+	if info.RelayMode == relayconstant.RelayModeResponsesCompact {
+		originModelName := info.OriginModelName
+		originPriceData := info.PriceData
+		if _, err = helper.ModelPriceHelper(c, info, info.GetEstimatePromptTokens(), &types.TokenCountMeta{}); err != nil {
+			info.OriginModelName = originModelName
+			info.PriceData = originPriceData
+			return types.NewError(err, types.ErrorCodeModelPriceError, types.ErrOptionWithSkipRetry(), types.ErrOptionWithStatusCode(http.StatusBadRequest))
+		}
+		service.PostTextConsumeQuota(c, info, usage, nil)
+		info.OriginModelName = originModelName
+		info.PriceData = originPriceData
+		return nil
+	}
+	service.PostTextConsumeQuota(c, info, usage, nil)
+	return nil
+}
+
+func madAPICodexDispatchPayload(c *gin.Context, info *relaycommon.RelayInfo) (*madAPICodexDispatchRequest, error) {
+	if info == nil || info.ChannelMeta == nil {
+		return nil, fmt.Errorf("selected channel metadata is unavailable")
+	}
+	storage, err := common.GetBodyStorage(c)
+	if err != nil {
+		return nil, err
+	}
+	body, err := storage.Bytes()
+	if err != nil {
+		return nil, err
+	}
+	body = bytes.Clone(body)
+	body, err = sjson.SetBytes(body, "model", info.UpstreamModelName)
+	if err != nil {
+		return nil, fmt.Errorf("set upstream model: %w", err)
+	}
+	body, err = relaycommon.RemoveDisabledFields(body, info.ChannelOtherSettings, info.ChannelSetting.PassThroughBodyEnabled)
+	if err != nil {
+		return nil, err
+	}
+	if len(info.ParamOverride) > 0 {
+		body, err = relaycommon.ApplyParamOverrideWithRelayInfo(body, info)
+		if err != nil {
+			return nil, err
+		}
+	}
+	headers, err := channel.ResolveHeaderOverride(info, c)
+	if err != nil {
+		return nil, err
+	}
+	return &madAPICodexDispatchRequest{
+		ChannelType:  info.ChannelType,
+		ChannelID:    info.ChannelId,
+		BaseURL:      info.ChannelBaseUrl,
+		APIKey:       info.ApiKey,
+		Model:        info.UpstreamModelName,
+		Headers:      headers,
+		Body:         body,
+		Stream:       info.IsStream,
+		Compact:      info.RelayMode == relayconstant.RelayModeResponsesCompact,
+		RequestPath:  info.RequestURLPath,
+		SessionScope: fmt.Sprintf("user:%d:token:%d", info.UserId, info.TokenId),
+	}, nil
+}
