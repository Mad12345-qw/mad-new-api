+func madAPICodexWireProtocol(channelType int, model string) string {
+	switch channelType {
+	case appconstant.ChannelTypeCodex:
+		return madAPICodexProtocolOpenAIResponses
+	case appconstant.ChannelTypeAnthropic:
+		return madAPICodexProtocolAnthropicMessages
+	case appconstant.ChannelTypeGemini:
+		return madAPICodexProtocolGeminiGenerate
+	case appconstant.ChannelTypeXai:
+		return madAPICodexProtocolXAIResponses
+	case appconstant.ChannelTypeOpenAI:
+		if strings.HasPrefix(strings.ToLower(strings.TrimSpace(model)), "gpt-") {
+			return madAPICodexProtocolOpenAIResponses
+		}
+	}
+	return madAPICodexProtocolOpenAIChat
+}
+
+func madAPICodexBaseURLForProtocol(baseURL string, wireProtocol string) string {
+	baseURL = strings.TrimRight(strings.TrimSpace(baseURL), "/")
+	if baseURL == "" {
+		return ""
+	}
+	lower := strings.ToLower(baseURL)
+	switch wireProtocol {
+	case madAPICodexProtocolOpenAIResponses, madAPICodexProtocolXAIResponses, madAPICodexProtocolOpenAIChat:
+		if !strings.HasSuffix(lower, "/v1") {
+			baseURL += "/v1"
+		}
+	case madAPICodexProtocolAnthropicMessages:
+		if strings.HasSuffix(lower, "/v1") {
+			baseURL = baseURL[:len(baseURL)-len("/v1")]
+		}
+	case madAPICodexProtocolGeminiGenerate:
+		if strings.HasSuffix(lower, "/v1beta") {
+			baseURL = baseURL[:len(baseURL)-len("/v1beta")]
+		}
+	}
+	return baseURL
+}
