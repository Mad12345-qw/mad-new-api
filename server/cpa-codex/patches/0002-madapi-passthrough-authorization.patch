+func applyMadAPIPassthroughAuthorization(req *http.Request, auth *cliproxyauth.Auth, headers http.Header) bool {
+	if auth == nil || auth.Attributes == nil || auth.Attributes["madapi_passthrough"] != "true" {
+		return true
+	}
+	if headers == nil {
+		return false
+	}
+	callerAuthorization := strings.TrimSpace(headers.Get("X-MadAPI-Authorization"))
+	if callerAuthorization == "" {
+		return false
+	}
+	frontToken := strings.TrimSpace(os.Getenv("MADAPI_INTERNAL_CATALOG_TOKEN"))
+	if frontToken == "" {
+		return false
+	}
+	req.Header.Set("Authorization", callerAuthorization)
+	req.Header.Set("X-MadAPI-CPA-Front-Token", frontToken)
+	return true
+}
