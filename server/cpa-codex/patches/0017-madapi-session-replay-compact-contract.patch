+func TestMadAPICodexStreamReportsCompletedResponse(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	chunks := make(chan cliproxyexecutor.StreamChunk, 2)
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\"}\n\n")}
+	chunks <- cliproxyexecutor.StreamChunk{Payload: []byte("event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp-stream\",\"output\":[]}}\n\n")}
+	close(chunks)
+	var completed []byte
+	if err := writeMadAPINativeStream(c, &cliproxyexecutor.StreamResult{Chunks: chunks}, time.Second, func(payload []byte) {
+		completed = append([]byte(nil), payload...)
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(completed), `"id":"resp-stream"`) {
+		t.Fatalf("completed response was not reported: %s", completed)
+	}
+}
