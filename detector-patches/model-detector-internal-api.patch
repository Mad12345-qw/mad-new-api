@@ -0,0 +1,124 @@
+package controller
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+)
+
+type modelDetectorKey struct {
+	Index   int    `json:"index"`
+	Key     string `json:"key"`
+	Enabled bool   `json:"enabled"`
+}
+
+type modelDetectorChannel struct {
+	ID           int                `json:"id"`
+	Name         string             `json:"name"`
+	Type         int                `json:"type"`
+	TypeName     string             `json:"type_name"`
+	Status       int                `json:"status"`
+	BaseURL      string             `json:"base_url"`
+	Models       []string           `json:"models"`
+	ModelMapping map[string]string  `json:"model_mapping"`
+	Keys         []modelDetectorKey `json:"keys"`
+}
+
+type modelDetectorDisableRequest struct {
+	Reason string `json:"reason"`
+	RunID  int    `json:"run_id"`
+}
+
+func GetModelDetectorHealth(c *gin.Context) {
+	common.ApiSuccess(c, gin.H{"contract_version": 1})
+}
+
+func GetModelDetectorChannels(c *gin.Context) {
+	channels := make([]*model.Channel, 0)
+	if err := model.DB.Order("id ASC").Find(&channels).Error; err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	result := make([]modelDetectorChannel, 0, len(channels))
+	for _, channel := range channels {
+		mapping := make(map[string]string)
+		if raw := strings.TrimSpace(channel.GetModelMapping()); raw != "" {
+			_ = json.Unmarshal([]byte(raw), &mapping)
+		}
+		keys := channel.GetKeys()
+		keyItems := make([]modelDetectorKey, 0, len(keys))
+		for index, key := range keys {
+			keyStatus := common.ChannelStatusEnabled
+			if status, ok := channel.ChannelInfo.MultiKeyStatusList[index]; ok {
+				keyStatus = status
+			}
+			keyItems = append(keyItems, modelDetectorKey{
+				Index:   index,
+				Key:     key,
+				Enabled: channel.Status == common.ChannelStatusEnabled && keyStatus == common.ChannelStatusEnabled,
+			})
+		}
+		result = append(result, modelDetectorChannel{
+			ID:           channel.Id,
+			Name:         channel.Name,
+			Type:         channel.Type,
+			TypeName:     constant.GetChannelTypeName(channel.Type),
+			Status:       channel.Status,
+			BaseURL:      channel.GetBaseURL(),
+			Models:       channel.GetModels(),
+			ModelMapping: mapping,
+			Keys:         keyItems,
+		})
+	}
+	c.Header("Cache-Control", "no-store")
+	common.ApiSuccess(c, gin.H{"contract_version": 1, "channels": result})
+}
+
+func DisableChannelByModelDetector(c *gin.Context) {
+	id, err := strconv.Atoi(c.Param("id"))
+	if err != nil || id <= 0 {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "invalid channel id"})
+		return
+	}
+	request := modelDetectorDisableRequest{}
+	if err := c.ShouldBindJSON(&request); err != nil || request.RunID <= 0 || strings.TrimSpace(request.Reason) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "run_id and reason are required"})
+		return
+	}
+	channel, err := model.GetChannelById(id, true)
+	if err != nil {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "message": "channel not found"})
+		return
+	}
+	if channel.Status != common.ChannelStatusEnabled {
+		common.ApiSuccess(c, gin.H{
+			"channel_id": id,
+			"changed":    false,
+			"status":     channel.Status,
+			"run_id":     request.RunID,
+		})
+		return
+	}
+	changed := model.UpdateChannelStatus(
+		id,
+		"",
+		common.ChannelStatusAutoDisabled,
+		"model detector: "+strings.TrimSpace(request.Reason),
+	)
+	if !changed {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "message": "channel status update failed"})
+		return
+	}
+	common.ApiSuccess(c, gin.H{
+		"channel_id": id,
+		"changed":    true,
+		"status":     common.ChannelStatusAutoDisabled,
+		"run_id":     request.RunID,
+	})
+}
