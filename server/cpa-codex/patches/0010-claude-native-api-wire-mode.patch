+func TestApplyClaudeHeaders_CloakNeverUsesNativeAPIHeaders(t *testing.T) {
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"api_key":    "key-native-api",
+		"cloak_mode": "never",
+	}}
+	req := newClaudeHeaderTestRequest(t, nil)
+	if errApply := applyClaudeHeaders(req, auth, "key-native-api", true, []string{claudeWebSearchBeta}, nil, nil); errApply != nil {
+		t.Fatalf("applyClaudeHeaders() error = %v", errApply)
+	}
+	if got := req.Header.Get("Anthropic-Beta"); got != claudeWebSearchBeta {
+		t.Fatalf("Anthropic-Beta = %q, want %q", got, claudeWebSearchBeta)
+	}
+	if got := req.Header.Get("Anthropic-Version"); got != "2023-06-01" {
+		t.Fatalf("Anthropic-Version = %q", got)
+	}
+	for _, header := range []string{"X-App", "X-Claude-Code-Session-Id", "X-Stainless-Runtime"} {
+		if got := req.Header.Get(header); got != "" {
+			t.Fatalf("%s = %q, want empty", header, got)
+		}
+	}
+	if got := req.Header.Get("Accept"); got != "text/event-stream" {
+		t.Fatalf("Accept = %q, want text/event-stream", got)
+	}
+	if got := req.Header.Get("Accept-Encoding"); got != "identity" {
+		t.Fatalf("Accept-Encoding = %q, want identity", got)
+	}
+}
