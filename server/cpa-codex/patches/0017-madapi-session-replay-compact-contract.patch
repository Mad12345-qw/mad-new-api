+func madAPICodexCompletedResponsePayload(payload []byte) []byte {
+	for _, frame := range bytes.Split(payload, []byte("\n\n")) {
+		frame = bytes.TrimSpace(frame)
+		if len(frame) == 0 {
+			continue
+		}
+		data := []byte(nil)
+		for _, line := range bytes.Split(frame, []byte("\n")) {
+			line = bytes.TrimSpace(line)
+			if bytes.HasPrefix(line, []byte("data:")) {
+				candidate := bytes.TrimSpace(bytes.TrimPrefix(line, []byte("data:")))
+				if len(candidate) > 0 {
+					data = candidate
+				}
+			}
+		}
+		if len(data) == 0 && json.Valid(frame) {
+			data = frame
+		}
+		if json.Valid(data) {
+			var event map[string]any
+			if json.Unmarshal(data, &event) == nil && event["type"] == "response.completed" {
+				return bytes.Clone(data)
+			}
+		}
+	}
+	return nil
+}
