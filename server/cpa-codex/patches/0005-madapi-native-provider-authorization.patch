+func prepareMadAPIPassthroughAuth(auth *Auth, headers http.Header) (*Auth, error) {
+	if auth == nil || !strings.EqualFold(strings.TrimSpace(auth.Attributes["madapi_passthrough"]), "true") {
+		return auth, nil
+	}
+
+	callerAuthorization := ""
+	if headers != nil {
+		callerAuthorization = strings.TrimSpace(headers.Get("X-MadAPI-Authorization"))
+	}
+	callerKey := callerAuthorization
+	if len(callerKey) >= len("Bearer ") && strings.EqualFold(callerKey[:len("Bearer ")], "Bearer ") {
+		callerKey = strings.TrimSpace(callerKey[len("Bearer "):])
+	}
+	frontToken := strings.TrimSpace(os.Getenv("MADAPI_INTERNAL_CATALOG_TOKEN"))
+	if callerKey == "" || frontToken == "" {
+		return auth, &Error{
+			Code:       requestScopedErrorCode,
+			Message:    "missing MadAPI caller authorization",
+			HTTPStatus: http.StatusUnauthorized,
+		}
+	}
+
+	requestAuth := auth.Clone()
+	if requestAuth.Attributes == nil {
+		requestAuth.Attributes = make(map[string]string)
+	}
+	requestAuth.Attributes[AttributeAPIKey] = callerKey
+	requestAuth.Attributes["header:X-MadAPI-CPA-Front-Token"] = frontToken
+	return requestAuth, nil
+}
