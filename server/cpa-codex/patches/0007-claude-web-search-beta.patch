+func TestApplyClaudeHeaders_WebSearchBetaIsConditional(t *testing.T) {
+	tests := []struct {
+		name     string
+		body     string
+		wantBeta bool
+	}{
+		{name: "web search tool", body: `{"tools":[{"type":"web_search_20250305","name":"web_search"}]}`, wantBeta: true},
+		{name: "web search name", body: `{"tools":[{"name":"web_search"}]}`, wantBeta: true},
+		{name: "ordinary function", body: `{"tools":[{"type":"custom","name":"lookup"}]}`, wantBeta: false},
+		{name: "no tools", body: `{}`, wantBeta: false},
+	}
+
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "key-web-search-beta"}}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			betas := appendClaudeWebSearchBeta([]byte(tt.body), nil)
+			req := newClaudeHeaderTestRequest(t, nil)
+			if errApply := applyClaudeHeaders(req, auth, "key-web-search-beta", false, betas, nil, nil); errApply != nil {
+				t.Fatalf("applyClaudeHeaders() error = %v", errApply)
+			}
+			hasBeta := strings.Contains(req.Header.Get("Anthropic-Beta"), claudeWebSearchBeta)
+			if hasBeta != tt.wantBeta {
+				t.Fatalf("Anthropic-Beta = %q, want web search beta = %t", req.Header.Get("Anthropic-Beta"), tt.wantBeta)
+			}
+		})
+	}
+}
