+func isMadAPIPassthroughAuth(auth *cliproxyauth.Auth) bool {
+	return auth != nil && auth.Attributes != nil && auth.Attributes["madapi_passthrough"] == "true"
+}
+
+func madAPIWorkCollapseRequest(body []byte, auth *cliproxyauth.Auth) []byte {
+	if !isMadAPIPassthroughAuth(auth) {
+		return body
+	}
+	marked, err := sjson.SetBytes(body, "metadata.madapi_collapse_work", true)
+	if err != nil {
+		return body
+	}
+	return marked
+}
