+func TestMadAPIResponseSessionRestoresReasoningForFullHistory(t *testing.T) {
+	resetMadAPIResponseSessions()
+	first := []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"first"}]}`)
+	response := []byte(`{"id":"resp-1","output":[{"id":"rs-1","type":"reasoning","summary":[{"type":"summary_text","text":"private reasoning"}]},{"id":"msg-1","type":"message","role":"assistant","content":[{"type":"output_text","text":"answer"}]}]}`)
+	rememberMadAPIResponseSession("scope-a", first, response)
+	continued, err := prepareMadAPIResponseSessionRequest("scope-a", []byte(`{"model":"deepseek-v4","input":[{"type":"message","role":"user","content":"first"},{"id":"msg-1","type":"message","role":"assistant","content":[{"type":"output_text","text":"answer"}]},{"type":"message","role":"user","content":"second"}]}`))
+	if err != nil {
+		t.Fatalf("prepare full-history continuation: %v", err)
+	}
+	reasoningIndex := strings.Index(string(continued), `"id":"rs-1"`)
+	messageIndex := strings.Index(string(continued), `"id":"msg-1"`)
+	if reasoningIndex < 0 || messageIndex < 0 || reasoningIndex > messageIndex {
+		t.Fatalf("reasoning was not restored before the matching message: %s", continued)
+	}
